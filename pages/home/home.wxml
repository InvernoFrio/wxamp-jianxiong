<!--pages/home/home.wxml-->
<view class="page-container paper-bg">
  <!-- 水墨背景装饰 -->
  <view class="ink-wash"></view>
  
  <!-- 吴健雄名言轮播 -->
  <view class="quote-section fade-slide-up">
    <swiper 
      class="quote-swiper" 
      autoplay 
      circular 
      interval="5000" 
      duration="800"
      vertical
    >
      <swiper-item wx:for="{{quotes}}" wx:key="index">
        <view class="quote-item">
          <text class="quote-text">"{{item.text}}"</text>
          <text class="quote-source">—— {{item.source}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 中央书本 - 翻书动画 -->
  <view class="book-area">
    <book-cover 
      id="bookCover"
      title="健 雄"
      subtitle="书 韵"
      author="吴健雄数字纪念馆"
      innerTitle="翻开书卷"
      innerSubtitle="探索一位伟大科学家的一生"
      bind:toggle="onBookToggle"
    />
    
    <!-- 点击提示 -->
    <view class="tap-hint {{bookOpening ? 'hidden' : ''}}">
      <text>点击翻开</text>
    </view>
  </view>

  <!-- 四个模块入口 - 书签式卡片 -->
  <view class="module-entrance {{showModules ? 'visible' : ''}}">
    <view 
      class="bookmark-card glass-card {{showModules ? 'scale-fade-in' : ''}}" 
      wx:for="{{modules}}" 
      wx:key="id"
      bindtap="onModuleTap"
      data-path="{{item.path}}"
      style="animation-delay: {{index * 0.1}}s"
    >
      <view class="bookmark-icon">{{item.icon}}</view>
      <view class="bookmark-info">
        <text class="bookmark-title">{{item.title}}</text>
        <text class="bookmark-desc">{{item.desc}}</text>
      </view>
      <view class="bookmark-arrow">›</view>
    </view>
  </view>
</view>
