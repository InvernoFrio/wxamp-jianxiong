<!-- pages/home/home.wxml -->
<view class="home-page {{pageReady ? 'page-enter' : ''}}">
  
  <!-- 1. 名言轮播 (保留原有功能) -->
  <view class="quote-section {{uiState === 'CHAT' ? '' : 'quote-fade'}}">
    <swiper
      class="quote-swiper"
      autoplay="{{true}}"
      interval="{{5000}}"
      circular="{{true}}"
      current="{{currentQuote}}"
      bindchange="onQuoteChange"
    >
      <swiper-item wx:for="{{quotes}}" wx:key="index">
        <view class="quote-item glass">
          <text class="quote-text">"{{item.text}}"</text>
          <text class="quote-source">—— {{item.source}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 2. 翻书动画 (保留原有组件) -->
  <view class="book-section {{uiState === 'MENU' ? 'book-pushed' : ''}}">
    <book-cover isOpen="{{bookOpen}}" bind:toggle="onBookToggle" />
  </view>

  <!-- 3. AI 对话窗口 (计划书新增) -->
  <view class="ai-chat-wrapper {{uiState === 'CHAT' ? 'ai-visible' : 'ai-hidden'}}">
    <view class="glass ai-window">
      <view class="ai-header serif-title">与吴健雄大先生对话</view>
      <view class="ai-content">
        <text class="ai-bubble">你好，我是吴健雄。关于物理或我的生平，你想了解什么？</text>
      </view>
      <view class="ai-input-bar">
        <input placeholder="向大先生提问..." placeholder-class="input-placeholder" />
        <view class="send-btn">发送</view>
      </view>
    </view>
  </view>

  <!-- 4. 模块入口 (升级版) -->
  <view class="modules {{uiState === 'MENU' ? 'modules-visible' : 'modules-hidden'}}">
    <view class="module-grid">
      <view class="module-item glass" data-page="timeline" bindtap="onModuleTap">
        <text class="module-icon">📜</text>
        <text class="module-name">生平年表</text>
      </view>
      <view class="module-item glass" data-page="reader" bindtap="onModuleTap">
        <text class="module-icon">📖</text>
        <text class="module-name">书韵阅读</text>
      </view>
      <view class="module-item glass" data-page="physics" bindtap="onModuleTap">
        <text class="module-icon">⚛️</text>
        <text class="module-name">物理之光</text>
      </view>
      <view class="module-item glass" data-page="multimedia" bindtap="onModuleTap">
        <text class="module-icon">🎞️</text>
        <text class="module-name">影音流年</text>
      </view>
      <view class="module-item glass" data-page="about" bindtap="onModuleTap">
        <text class="module-icon">ℹ️</text>
        <text class="module-name">关于我们</text>
      </view>
    </view>
  </view>

  <!-- 底部标语 -->
  <view class="footer-slogan {{uiState === 'CHAT' ? '' : 'slogan-hide'}}">
    <text>科学是没有国界的，但科学家有自己的祖国。</text>
  </view>
</view>