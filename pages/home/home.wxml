<!-- pages/home/home.wxml -->
<view class="home-page {{pageReady ? 'page-enter' : ''}}">

  <!-- 顶部金句 -->
  <view class="top-quote-area {{bookOpen ? 'quote-visible' : 'quote-hidden'}}">
    <text class="quote-content serif-title">"{{quotes[currentQuote].text}}"</text>
    <view class="quote-line"></view>
  </view>

  <!-- 书本 + 操作栏 -->
  <view class="main-layout {{bookOpen ? 'layout-shifted' : ''}}">
    <view class="book-area">
      <view class="book-container {{bookPage === 2 ? 'book-container-shrunk' : ''}}">
        <book-cover
          id="bookCover"
          isOpen="{{bookOpen}}"
          chapters="{{chapters}}"
          bind:pagechange="onPageChange"
          bind:gridwalking="onGridWalking"
          bind:chaptertap="onBookChapterTap"
        />
      </view>

      <!-- 灵动岛风格操作栏 -->
      <view class="action-island {{bookOpen ? 'island-show' : 'island-hide'}}">
        <!-- 第1页：探索地图 -->
        <block wx:if="{{bookPage === 1}}">
          <view class="island-btn" bindtap="onBarClose">
            <text class="island-icon">📕</text>
            <text class="island-text">合上</text>
          </view>
          <view class="island-divider"></view>
          <view class="island-btn primary" bindtap="onBarExplore">
            <text class="island-icon">🗺️</text>
            <text class="island-text">开始探索</text>
          </view>
          <view class="island-divider"></view>
          <view class="island-btn" bindtap="onBarReader">
            <text class="island-icon">📖</text>
            <text class="island-text">直接阅读</text>
          </view>
        </block>
        <!-- 第2页：直接阅读 -->
        <block wx:elif="{{bookPage === 2}}">
          <view class="island-btn" bindtap="onBarMap">
            <text class="island-icon">🗺️</text>
            <text class="island-text">探索地图</text>
          </view>
          <view class="island-divider"></view>
          <view class="island-btn" bindtap="onBarClose">
            <text class="island-icon">📕</text>
            <text class="island-text">合上书本</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 章节列表 -->
    <view class="chapter-list {{bookPage === 2 ? 'list-show' : 'list-hide'}}">
      <view
        wx:for="{{chapters}}" wx:key="page"
        class="chapter-item"
        hover-class="active" 
        hover-stay-time="100"
        style="transition-delay: {{index * 0.06 + 0.15}}s"
        data-page="{{item.page}}"
        bindtap="onModuleTap"
      >
        <text class="chapter-icon">{{item.icon}}</text>
        <text class="chapter-name serif-title">{{item.name}}</text>
        <text class="chapter-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部标语 -->
  <view class="footer-slogan {{bookOpen ? 'slogan-fade' : ''}}">
    <text>科学是没有国界的，但科学家有自己的祖国。</text>
  </view>

</view>
