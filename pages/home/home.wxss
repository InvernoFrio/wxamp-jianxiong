.home-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 6%, rgba(196, 30, 58, 0.08), transparent 32%),
    radial-gradient(circle at 8% 85%, rgba(212, 165, 116, 0.16), transparent 40%),
    linear-gradient(180deg, #f9f6ef 0%, #f5f0e8 38%, #efe7da 100%);
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

/* 名言轮播 */
.quote-section {
  margin-bottom: 28rpx;
  padding-top: 10rpx;
  position: relative;
  z-index: 2;
}

.quote-swiper {
  height: 248rpx;
  overflow: visible;
}

.quote-item {
  height: calc(100% - 28rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 40rpx;
  background: rgba(255, 255, 255, 0.34);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(77, 56, 34, 0.11);
  margin: 0 8rpx 28rpx;
  position: relative;
  overflow: hidden;
}

.quote-text {
  font-size: 30rpx;
  color: #2C2C2C;
  text-align: center;
  line-height: 1.72;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  letter-spacing: 1rpx;
}

.quote-source {
  font-size: 24rpx;
  color: #C41E3A;
  letter-spacing: 2rpx;
  font-style: italic;
}

/* 书本区域 */
.book-section {
  display: flex;
  justify-content: center;
  margin: 20rpx 0 42rpx;
  position: relative;
  z-index: 1;
}

.book-section::before {
  content: '';
  position: absolute;
  width: 420rpx;
  height: 92rpx;
  bottom: -20rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(44, 44, 44, 0.15) 0%, rgba(44, 44, 44, 0.015) 68%, transparent 100%);
  filter: blur(6rpx);
}

/* 模块入口 */
.modules {
  overflow: hidden;
  transition: all 0.55s ease;
}

.modules-visible {
  max-height: 500rpx;
  opacity: 1;
  margin-bottom: 40rpx;
  transform: translateY(0);
}

.modules-hidden {
  max-height: 0;
  opacity: 0;
  margin-bottom: 0;
  transform: translateY(20rpx);
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 8rpx;
}

.module-item {
  width: 48%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 20rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(61, 44, 35, 0.1);
}

.module-item:active {
  transform: scale(0.965) translateY(2rpx);
  transition: transform 0.2s ease;
}

.module-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.module-name {
  font-size: 27rpx;
  color: #2C2C2C;
  font-weight: 500;
  letter-spacing: 1rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 底部标语 */
.footer-slogan {
  text-align: center;
  padding: 28rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-slogan text {
  font-size: 24rpx;
  color: #7e8f9e;
  font-style: italic;
  letter-spacing: 1rpx;
}

/* 轮播指示点 */
swiper .wx-swiper-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(139, 157, 175, 0.35) !important;
  box-shadow: none !important;
}

swiper .wx-swiper-dot.wx-swiper-dot-active {
  width: 30rpx;
  border-radius: 7rpx;
  background: #C41E3A !important;
}
