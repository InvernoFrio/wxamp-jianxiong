.home-page {
  min-height: 100vh;
  background: #F5F0E8;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

/* 名言轮播 */
.quote-section {
  margin-bottom: 40rpx;
}

.quote-swiper {
  height: 200rpx;
}

.quote-item {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin: 0 8rpx;
}

.quote-text {
  font-size: 28rpx;
  color: #2C2C2C;
  text-align: center;
  line-height: 1.8;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.quote-source {
  font-size: 24rpx;
  color: #C41E3A;
}

/* 书本区域 */
.book-section {
  display: flex;
  justify-content: center;
  margin: 40rpx 0;
}

/* 模块入口 */
.modules {
  overflow: hidden;
  transition: all 0.5s ease;
}

.modules-visible {
  max-height: 500rpx;
  opacity: 1;
  margin-bottom: 40rpx;
}

.modules-hidden {
  max-height: 0;
  opacity: 0;
  margin-bottom: 0;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.module-item {
  width: 48%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.module-item:active {
  transform: scale(0.96);
  transition: transform 0.2s ease;
}

.module-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.module-name {
  font-size: 26rpx;
  color: #2C2C2C;
  font-weight: 500;
}

/* 底部标语 */
.footer-slogan {
  text-align: center;
  padding: 40rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-slogan text {
  font-size: 24rpx;
  color: #8B9DAF;
  font-style: italic;
}
