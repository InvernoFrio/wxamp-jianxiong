/* pages/home/home.wxss */
.home-page {
  min-height: 100vh;
  background:
    linear-gradient(90deg, rgba(120, 92, 52, 0.025) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(120, 92, 52, 0.02) 1rpx, transparent 1rpx),
    radial-gradient(circle at 86% 6%, rgba(166, 33, 33, 0.045), transparent 34%),
    radial-gradient(circle at 9% 82%, rgba(92, 112, 126, 0.07), transparent 38%),
    linear-gradient(180deg, #fbf8f1 0%, #f4eee4 44%, #eadfce 100%);
  background-size: 44rpx 44rpx, 44rpx 44rpx, auto, auto, auto;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: hidden;
}

/* === 顶部金句 === */
.top-quote-area {
  width: 100%;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.8s ease;
}

.quote-hidden { opacity: 0; transform: translateY(20rpx); }
.quote-visible { opacity: 1; transform: translateY(0); }

.quote-content {
  font-size: 29rpx;
  color: var(--jianxiong-red);
  text-align: center;
  line-height: 1.72;
  padding: 0 34rpx;
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.8);
}

.quote-line {
  width: 72rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, var(--jianxiong-red), var(--gold-accent), transparent);
  margin-top: 24rpx;
  border-radius: 2rpx;
}

/* === 主体布局 === */
.main-layout {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  margin-top: 40rpx;
}

.layout-shifted {
  transform: translateY(-30rpx);
}

.book-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.book-container {
  width: 100%;
  height: 780rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  transition: height 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.book-container-shrunk {
  height: 440rpx;
}

/* === 灵动岛操作栏 === */
.action-island {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(28rpx) saturate(1.06);
  -webkit-backdrop-filter: blur(28rpx) saturate(1.06);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow:
    0 12rpx 34rpx rgba(70, 48, 28, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  transition: all 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  z-index: 20;
}

.island-show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.island-hide {
  opacity: 0;
  transform: translateY(16rpx) scale(0.92);
  pointer-events: none;
  margin-top: 0;
  height: 0;
  padding: 0;
  overflow: hidden;
}

.island-btn {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 100%;
  border-radius: 36rpx;
  transition: opacity 0.15s, background 0.2s;
}

.island-btn:active {
  opacity: 0.5;
  background: rgba(166, 33, 33, 0.06);
}

.island-btn.primary .island-text {
  color: #C41E3A;
  font-weight: 600;
}

.island-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.island-text {
  font-size: 22rpx;
  color: #54606B;
  font-weight: 500;
  white-space: nowrap;
}

.island-divider {
  width: 1rpx;
  height: 32rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 0 8rpx;
}

/* === 章节列表 === */
.chapter-list {
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-top: 32rpx;
  transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
}

.list-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.list-hide {
  opacity: 0;
  transform: translateY(24rpx);
  pointer-events: none;
  height: 0;
  overflow: hidden;
  margin-top: 0;
  padding: 0;
}

.chapter-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  padding: 32rpx 36rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 10rpx 28rpx rgba(70, 48, 28, 0.055),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.chapter-item.active {
  transform: scale(0.96); 
  background: rgba(245, 240, 232, 0.9) !important; 
  box-shadow: inset 0 2rpx 10rpx rgba(0, 0, 0, 0.05); 
  border-color: rgba(166, 33, 33, 0.2); 
}

.chapter-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.chapter-name {
  font-size: 28rpx;
  color: var(--ink-black);
  font-weight: 500;
}

.chapter-arrow {
  margin-left: auto;
  color: var(--gold-accent);
  font-size: 36rpx;
  opacity: 0.4;
}

/* === AI 灵感岛 === */
/* AI 灵感岛 容器：负责整体的位移和显隐 */
.ai-island-wrapper {
  position: fixed;
  bottom: 60rpx;
  left: 48rpx;
  right: 48rpx;
  z-index: 1000;
  
  /* 核心：入场退出动画 */
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), 
              opacity 0.6s ease,
              bottom 0.4s ease; /* 兼容展开时的位置微调 */
}

/* 状态1：隐藏中（在屏幕下方） */
.ai-island-wrapper.island-hidden {
  transform: translateY(200%); /* 移动到屏幕外 */
  opacity: 0;
  pointer-events: none; /* 隐藏时不可点击 */
}

/* 状态2：激活显示（随章节列表同步出现） */
.ai-island-wrapper.island-active {
  transform: translateY(0);
  opacity: 1;
}

/* 展开状态下的特殊处理：如果是展开模式，可以微调距离底部的距离 */
.ai-island-wrapper.expanded {
  bottom: 40rpx; 
}

/* AI 岛屿主体：负责高度切换和背景 */
.ai-island {
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.1);
}

.collapsed .ai-island {
  height: 100rpx;
  border-radius: 50rpx;
  padding: 0 40rpx;
}

.expanded .ai-island {
  height: 640rpx;
  border-radius: 40rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.95) !important;
}

/* 内部元素样式 */
.ai-bar {
  height: 100%;
  display: flex;
  align-items: center;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--jianxiong-red);
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 0 12rpx rgba(166, 33, 33, 0.4);
}

.expand-hint {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--slate-gray);
}

.ai-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.ai-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.close-icon {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
}

.ai-chat-box {
  flex: 1;
  margin-bottom: 24rpx;
}

.ai-msg {
  background: #f5f0e8;
  padding: 24rpx;
  border-radius: 0 24rpx 24rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.ai-input-group {
  display: flex;
  background: #fff;
  border-radius: 100rpx;
  padding: 8rpx 8rpx 8rpx 32rpx;
  align-items: center;
  border: 1rpx solid #eee;
}

.ai-input-group input {
  flex: 1;
  font-size: 26rpx;
}

.ai-send-btn {
  background: var(--jianxiong-red);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
}

/* === 底部标语 === */
.footer-slogan {
  margin-top: auto;
  padding: 40rpx 0;
  text-align: center;
  transition: opacity 0.3s;
}

.footer-slogan text {
  font-size: 24rpx;
  color: var(--slate-gray);
  opacity: 0.6;
}

.slogan-fade {
  opacity: 0;
}

/* === 悬浮对话球 === */
.floating-chat-ball {
  position: fixed;
  width: 112rpx;
  height: 112rpx;
  z-index: 9999;
  pointer-events: auto;
  filter: drop-shadow(0 12rpx 24rpx rgba(99, 50, 42, 0.16));
}

.ball-content {
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 35% 28%, rgba(255,255,255,0.8), transparent 30%),
    rgba(166, 33, 33, 0.16);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 2rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(166, 33, 33, 0.2),
    inset 0 1rpx 0 rgba(255,255,255,0.85);
  position: relative;
  overflow: hidden;
}

.ball-icon {
  font-size: 48rpx;
  z-index: 2;
}

/* 呼吸灯特效 */
.ball-ripple {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(166, 33, 33, 0.2);
  border-radius: 50%;
  animation: ball-pulse 2s infinite ease-in-out;
  z-index: 1;
}

@keyframes ball-pulse {
  0% { transform: scale(0.8); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 0; }
  100% { transform: scale(0.8); opacity: 0; }
}

/* 入场动画 */
.floating-chat-ball {
  animation: ball-appear 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes ball-appear {
  from { transform: scale(0) rotate(-180deg); opacity: 0; }
  to { transform: scale(1) rotate(0); opacity: 1; }
}
