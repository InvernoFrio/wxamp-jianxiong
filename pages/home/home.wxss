/* pages/home/home.wxss */

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 水墨晕染背景 */
.ink-wash {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(ellipse at 15% 20%, rgba(44, 44, 44, 0.03) 0%, transparent 40%),
    radial-gradient(ellipse at 85% 80%, rgba(139, 157, 175, 0.05) 0%, transparent 45%),
    radial-gradient(ellipse at 50% 50%, rgba(212, 165, 116, 0.04) 0%, transparent 60%);
  pointer-events: none;
}

/* 名言区域 */
.quote-section {
  width: 100%;
  height: 120rpx;
  margin-top: 80rpx;
  padding: 0 40rpx;
}

.quote-swiper {
  height: 100%;
}

.quote-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 20rpx;
}

.quote-text {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--ink-black);
  text-align: center;
  line-height: 1.6;
}

.quote-source {
  font-size: 22rpx;
  color: var(--gray-blue);
  margin-top: 8rpx;
}

/* 书本区域 */
.book-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

/* 点击提示 */
.tap-hint {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--gray-blue);
  opacity: 0.8;
  animation: pulse-hint 2s ease-in-out infinite;
}

.tap-hint.hidden {
  opacity: 0;
  transition: opacity 0.3s;
}

@keyframes pulse-hint {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 模块入口 */
.module-entrance {
  width: 100%;
  padding: 20rpx 32rpx 120rpx;
  opacity: 0;
  transform: translateY(60rpx);
  transition: all 0.5s ease-out;
}

.module-entrance.visible {
  opacity: 1;
  transform: translateY(0);
}

/* 书签式卡片 */
.bookmark-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.bookmark-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--vermillion);
  border-radius: 3rpx 0 0 3rpx;
}

.bookmark-card:active {
  background: rgba(255, 255, 255, 0.4);
}

.bookmark-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.bookmark-info {
  flex: 1;
}

.bookmark-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: var(--ink-black);
  font-weight: 600;
  display: block;
}

.bookmark-desc {
  font-size: 24rpx;
  color: var(--gray-blue);
  margin-top: 4rpx;
  display: block;
}

.bookmark-arrow {
  font-size: 36rpx;
  color: var(--gray-blue);
  margin-left: 16rpx;
}
