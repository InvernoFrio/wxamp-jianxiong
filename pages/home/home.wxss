/* pages/home/home.wxss */
.home-page {
  min-height: 100vh;
  /* 恢复原本的纸张感背景 */
  background:
    radial-gradient(circle at 86% 6%, rgba(166, 33, 33, 0.05), transparent 32%),
    radial-gradient(circle at 8% 85%, rgba(212, 165, 116, 0.1), transparent 40%),
    linear-gradient(180deg, #f9f6ef 0%, #f5f0e8 38%, #efe7da 100%);
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 顶部金句 */
.top-quote-area {
  width: 100%;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.8s ease;
}

.quote-hidden {
  opacity: 0;
  transform: translateY(20rpx);
}

.quote-visible {
  opacity: 1;
  transform: translateY(0);
}

.quote-content {
  font-size: 30rpx;
  color: var(--jianxiong-red);
  text-align: center;
  line-height: 1.6;
  padding: 0 40rpx;
}

.quote-line {
  width: 60rpx;
  height: 4rpx;
  background: var(--gold-accent);
  margin-top: 24rpx;
  border-radius: 2rpx;
}

/* 主体布局 */
.main-layout {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  margin-top: 40rpx;
}

.layout-shifted {
  transform: translateY(-40rpx);
}

/* 修复书本显示：确保容器有明确的宽度和高度 */
.book-container {
  width: 100%;
  height: 460rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
  z-index: 10;
}

/* 章节列表 */
.chapter-list {
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
  transition: all 0.5s ease;
}

.list-hidden {
  opacity: 0;
  transform: translateY(40rpx);
  pointer-events: none;
  height: 0;
  overflow: hidden;
}

.list-visible {
  opacity: 1;
  transform: translateY(0);
}

.chapter-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  padding: 36rpx 40rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.chapter-num {
  font-size: 24rpx;
  color: var(--gold-accent);
  margin-right: 32rpx;
  width: 40rpx;
}

.chapter-title {
  font-size: 30rpx;
  color: var(--ink-black);
  font-weight: 500;
}

.chapter-arrow {
  margin-left: auto;
  color: var(--gold-accent);
  font-size: 40rpx;
  opacity: 0.5;
}

/* AI 灵感岛 */
.ai-island-wrapper {
  position: fixed;
  bottom: 60rpx;
  left: 48rpx;
  right: 48rpx;
  z-index: 1000;
}

.ai-island {
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.collapsed .ai-island {
  height: 100rpx;
  border-radius: 50rpx;
  padding: 0 40rpx;
}

.expanded .ai-island {
  height: 640rpx;
  border-radius: 40rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.9) !important;
}

.ai-bar {
  height: 100%;
  display: flex;
  align-items: center;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--jianxiong-red);
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 0 12rpx rgba(166, 33, 33, 0.4);
}

.expand-hint {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--slate-gray);
}

.ai-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.ai-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.close-icon {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
}

.ai-chat-box {
  flex: 1;
  margin-bottom: 24rpx;
}

.ai-msg {
  background: #f5f0e8;
  padding: 24rpx;
  border-radius: 0 24rpx 24rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.ai-input-group {
  display: flex;
  background: #fff;
  border-radius: 100rpx;
  padding: 8rpx 8rpx 8rpx 32rpx;
  align-items: center;
  border: 1rpx solid #eee;
}

.ai-input-group input {
  flex: 1;
  font-size: 26rpx;
}

.ai-send-btn {
  background: var(--jianxiong-red);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
}

.footer-slogan {
  margin-top: auto;
  padding: 40rpx 0;
  text-align: center;
  transition: opacity 0.3s;
}

.footer-slogan text {
  font-size: 24rpx;
  color: var(--slate-gray);
  opacity: 0.6;
}

.slogan-fade {
  opacity: 0;
}

.fade-in {
  opacity: 1;
  transform: translateY(0);
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  pointer-events: auto;
}

.fade-out {
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.4s ease;
  pointer-events: none;
}