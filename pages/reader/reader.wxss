.reader-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 0% 0%, rgba(212, 165, 116, 0.2), transparent 36%),
    radial-gradient(circle at 100% 16%, rgba(196, 30, 58, 0.08), transparent 28%),
    linear-gradient(180deg, #f9f4ec 0%, #f5f0e8 48%, #eee5d7 100%);
  display: flex;
  flex-direction: column;
}

/* 章节导航 */
.chapter-nav {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.58);
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.chapter-tab {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #8B9DAF;
  background: rgba(255, 255, 255, 0.45);
  transition: all 0.3s ease;
}

.chapter-tab:active {
  transform: scale(0.95);
  transition: transform 0.15s ease;
}

.chapter-tab.active {
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.2), rgba(196, 30, 58, 0.12));
  color: #C41E3A;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.14);
}

/* 章节标题 */
.chapter-header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.14);
}

.chapter-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.chapter-subtitle {
  font-size: 24rpx;
  color: #8B9DAF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 小节列表 */
.section-list {
  padding: 20rpx 24rpx;
  flex: 1;
}

.section-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.44);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(75, 58, 37, 0.08);
}

.section-item:active {
  transform: scale(0.98) translateY(2rpx);
  transition: transform 0.15s ease;
  box-shadow: 0 4rpx 10rpx rgba(75, 58, 37, 0.06);
}

.section-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.2), rgba(196, 30, 58, 0.1));
  color: #C41E3A;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.section-info {
  flex: 1;
}

.section-name {
  font-size: 30rpx;
  color: #2C2C2C;
  font-weight: 500;
  display: block;
}

.section-page {
  font-size: 22rpx;
  color: #8B9DAF;
}

.section-arrow {
  font-size: 36rpx;
  color: #8B9DAF;
  margin-left: 16rpx;
}

/* 阅读模式 */
.reading-mode {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.reading-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.14);
  background: rgba(255, 255, 255, 0.45);
}

.back-btn {
  padding: 8rpx 16rpx;
  margin-right: 16rpx;
  transition: transform 0.15s ease;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-btn text {
  font-size: 28rpx;
  color: #C41E3A;
}

.reading-title {
  font-size: 31rpx;
  color: #2C2C2C;
  font-weight: 500;
  flex: 1;
}

.reading-scroll {
  flex: 1;
  height: 0;
}

/* 笔记浮动按钮 */
.notes-fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, rgba(196, 30, 58, 0.94), rgba(163, 24, 45, 0.93));
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(196, 30, 58, 0.36);
  z-index: 300;
  pointer-events: auto;
}

.notes-fab text {
  font-size: 40rpx;
}

.notes-fab:active {
  transform: scale(0.92);
  transition: transform 0.2s ease;
}

/* 笔记面板 */
.notes-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  pointer-events: none;
}

.notes-panel-open {
  pointer-events: auto;
}

.notes-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.notes-panel-open .notes-overlay {
  opacity: 1;
}

.notes-drawer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 78vh;
  background: linear-gradient(180deg, #f9f4eb 0%, #f3ebdd 100%);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.35s ease;
  display: flex;
  flex-direction: column;
}

.notes-panel-open .notes-drawer {
  transform: translateY(0);
}

.notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
}

.notes-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.notes-summary {
  padding: 10rpx 32rpx 14rpx;
}

.notes-summary text {
  font-size: 23rpx;
  color: #7f8f9c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.notes-close {
  font-size: 36rpx;
  color: #8B9DAF;
  padding: 8rpx;
}

.notes-tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
}

.notes-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8B9DAF;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.notes-tab.active {
  color: #C41E3A;
  font-weight: 500;
}

.notes-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 5rpx;
  background: #C41E3A;
  border-radius: 2rpx;
  transition: all 0.25s ease;
}

.notes-list {
  flex: 1;
  padding: 20rpx 24rpx calc(26rpx + env(safe-area-inset-bottom));
}

.notes-empty {
  text-align: center;
  padding: 80rpx 0;
}

.notes-empty text {
  font-size: 28rpx;
  color: #8B9DAF;
}

.note-item {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 5rpx 14rpx rgba(62, 47, 30, 0.07);
}

.note-item-content {
  flex: 1;
}

.note-item-text {
  font-size: 25rpx;
  color: #2C2C2C;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.68;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.note-item-note {
  font-size: 27rpx;
  color: #C41E3A;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
  line-height: 1.56;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.note-item-meta {
  font-size: 22rpx;
  color: #7f8f9c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.note-item-delete {
  padding: 10rpx 18rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: rgba(196, 30, 58, 0.12);
  border: 1rpx solid rgba(196, 30, 58, 0.22);
}

.note-item-delete text {
  font-size: 23rpx;
  color: #C41E3A;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
