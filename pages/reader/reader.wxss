/* ═══════════════════════════════════════════════
   阅读器页面样式
   ═══════════════════════════════════════════════ */

.reader-page {
  height: 100vh;
  min-height: 100vh;
  background:
    radial-gradient(circle at 0% 0%, rgba(212, 165, 116, 0.2), transparent 36%),
    radial-gradient(circle at 100% 16%, rgba(196, 30, 58, 0.08), transparent 28%),
    linear-gradient(180deg, #f9f4ec 0%, #f5f0e8 48%, #eee5d7 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.reader-page.page-enter {
  transform: none;
  animation: readerFadeIn 480ms ease-out forwards;
}

@keyframes readerFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ── 深色主题 ──────────────────────────────── */

.reader-page.dark {
  background:
    radial-gradient(circle at 0% 0%, rgba(60, 50, 40, 0.5), transparent 40%),
    radial-gradient(circle at 100% 16%, rgba(100, 30, 40, 0.12), transparent 30%),
    linear-gradient(180deg, #1A1A1A 0%, #1E1C1A 48%, #22201E 100%);
}

.reader-page.dark .chapter-nav {
  background: rgba(30, 28, 26, 0.88);
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .chapter-tab {
  background: rgba(255, 255, 255, 0.06);
  color: #8B9DAF;
}

.reader-page.dark .chapter-tab.active {
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.28), rgba(196, 30, 58, 0.16));
  color: #E87A8A;
}

.reader-page.dark .chapter-title {
  color: #E0DDD7;
}

.reader-page.dark .chapter-subtitle {
  color: #6B7B8D;
}

.reader-page.dark .section-item {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

.reader-page.dark .section-name {
  color: #E0DDD7;
}

.reader-page.dark .section-arrow {
  color: #6B7B8D;
}

.reader-page.dark .reading-toolbar {
  background: rgba(30, 28, 26, 0.88);
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .back-btn text {
  color: #E87A8A;
}

.reader-page.dark .reading-title {
  color: #E0DDD7;
}

.reader-page.dark .toolbar-btn text {
  color: #8B9DAF;
}

.reader-page.dark .bottom-nav {
  background: rgba(30, 28, 26, 0.92);
  border-top-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .bottom-nav-btn text {
  color: #8B9DAF;
}

.reader-page.dark .bottom-nav-progress text {
  color: #6B7B8D;
}

.reader-page.dark .notes-drawer {
  background: linear-gradient(180deg, #252320 0%, #1E1C1A 100%);
}

.reader-page.dark .notes-title {
  color: #E0DDD7;
}

.reader-page.dark .notes-close {
  color: #6B7B8D;
}

.reader-page.dark .notes-tab {
  color: #6B7B8D;
}

.reader-page.dark .notes-tab.active {
  color: #E87A8A;
}

.reader-page.dark .note-item {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .note-item-text {
  color: #D0CDC7;
}

.reader-page.dark .note-item-note {
  color: #E87A8A;
}

.reader-page.dark .note-item-meta {
  color: #6B7B8D;
}

.reader-page.dark .note-editor-card {
  background: linear-gradient(180deg, #252320 0%, #1E1C1A 100%);
}

.reader-page.dark .note-editor-title {
  color: #E0DDD7;
}

.reader-page.dark .note-editor-quote {
  background: rgba(255, 255, 255, 0.06);
  color: #8B9DAF;
}

.reader-page.dark .note-editor-input {
  background: rgba(255, 255, 255, 0.08);
  color: #E0DDD7;
  border-color: rgba(255, 255, 255, 0.1);
}

.reader-page.dark .note-editor-cancel {
  background: rgba(255, 255, 255, 0.08);
  color: #8B9DAF;
}

.reader-page.dark .settings-drawer {
  background: linear-gradient(180deg, #252320 0%, #1E1C1A 100%);
}

.reader-page.dark .settings-title {
  color: #E0DDD7;
}

.reader-page.dark .settings-close {
  color: #6B7B8D;
}

.reader-page.dark .settings-label {
  color: #D0CDC7;
}

.reader-page.dark .theme-option {
  background: rgba(255, 255, 255, 0.06);
  color: #8B9DAF;
  border-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .theme-option.active {
  background: rgba(196, 30, 58, 0.2);
  color: #E87A8A;
  border-color: rgba(196, 30, 58, 0.4);
}

.reader-page.dark .bookmark-item {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .bookmark-title {
  color: #E0DDD7;
}

.reader-page.dark .bookmark-chapter {
  color: #6B7B8D;
}

.reader-page.dark .search-panel {
  background: rgba(30, 28, 26, 0.98);
}

.reader-page.dark .search-input {
  background: rgba(255, 255, 255, 0.08);
  color: #E0DDD7;
}

.reader-page.dark .search-close {
  color: #8B9DAF;
}

.reader-page.dark .search-result-item {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
}

.reader-page.dark .search-result-title {
  color: #E0DDD7;
}

.reader-page.dark .search-result-snippet {
  color: #8B9DAF;
}

.reader-page.dark .search-empty text {
  color: #6B7B8D;
}

/* ── 章节导航 ──────────────────────────────── */

.chapter-nav {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.58);
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.chapter-tab {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #8B9DAF;
  background: rgba(255, 255, 255, 0.45);
  transition: all 0.3s ease;
}

.chapter-tab:active {
  transform: scale(0.95);
  transition: transform 0.15s ease;
}

.chapter-tab.active {
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.2), rgba(196, 30, 58, 0.12));
  color: #C41E3A;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.14);
}

/* ── 章节标题 ──────────────────────────────── */

.chapter-header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.14);
}

.chapter-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.chapter-subtitle {
  font-size: 24rpx;
  color: #8B9DAF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ── 小节列表 ──────────────────────────────── */

.section-list {
  padding: 20rpx 24rpx;
  flex: 1;
}

.section-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.44);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(75, 58, 37, 0.08);
}

.section-item:active {
  transform: scale(0.98) translateY(2rpx);
  transition: transform 0.15s ease;
  box-shadow: 0 4rpx 10rpx rgba(75, 58, 37, 0.06);
}

.section-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.2), rgba(196, 30, 58, 0.1));
  color: #C41E3A;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.section-info {
  flex: 1;
}

.section-name {
  font-size: 30rpx;
  color: #2C2C2C;
  font-weight: 500;
  display: block;
}

.section-arrow {
  font-size: 36rpx;
  color: #8B9DAF;
  margin-left: 16rpx;
}

/* ── 阅读模式 ──────────────────────────────── */

.reading-mode {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.reading-toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.14);
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.back-btn {
  padding: 8rpx 16rpx;
  margin-right: 16rpx;
  transition: transform 0.15s ease;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-btn text {
  font-size: 28rpx;
  color: #C41E3A;
}

.reading-title {
  font-size: 31rpx;
  color: #2C2C2C;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.toolbar-btn {
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  transition: background 0.2s ease;
}

.toolbar-btn:active {
  background: rgba(0, 0, 0, 0.06);
}

.toolbar-btn text {
  font-size: 32rpx;
  color: #5A5A5A;
}

.toolbar-btn.bookmarked text {
  color: #D4A574;
}

.reading-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  position: relative;
}

.reading-progress-bar {
  position: sticky;
  top: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #C41E3A, #D4A574);
  z-index: 10;
  transition: width 0.3s ease;
}

/* ── 底部导航 ──────────────────────────────── */

.bottom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-top: 1rpx solid rgba(139, 157, 175, 0.14);
}

.bottom-nav-btn {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(139, 157, 175, 0.16);
  transition: all 0.2s ease;
}

.bottom-nav-btn:active {
  transform: scale(0.96);
  background: rgba(196, 30, 58, 0.08);
}

.bottom-nav-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.bottom-nav-btn text {
  font-size: 26rpx;
  color: #5A5A5A;
}

.bottom-nav-progress {
  flex-shrink: 0;
}

.bottom-nav-progress text {
  font-size: 24rpx;
  color: #8B9DAF;
}

/* ── 笔记浮动按钮 ──────────────────────────── */

.notes-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, rgba(196, 30, 58, 0.94), rgba(163, 24, 45, 0.93));
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(196, 30, 58, 0.36);
  z-index: 300;
  pointer-events: auto;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.notes-fab text {
  font-size: 40rpx;
}

.notes-fab:active {
  transform: scale(0.92);
}

.notes-fab-hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(18rpx) scale(0.92);
}

/* ── 笔记面板 ──────────────────────────────── */

.notes-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  pointer-events: none;
}

.notes-panel-open {
  pointer-events: auto;
}

.notes-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.notes-panel-open .notes-overlay {
  opacity: 1;
}

.notes-drawer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 78vh;
  background: linear-gradient(180deg, #f9f4eb 0%, #f3ebdd 100%);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.35s ease;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.notes-panel-open .notes-drawer {
  transform: translateY(0);
}

.notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
}

.notes-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.notes-summary {
  padding: 10rpx 32rpx 14rpx;
}

.notes-summary text {
  font-size: 23rpx;
  color: #7f8f9c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.notes-close {
  font-size: 36rpx;
  color: #8B9DAF;
  padding: 8rpx;
}

.notes-tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
}

.notes-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8B9DAF;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.notes-tab.active {
  color: #C41E3A;
  font-weight: 500;
}

.notes-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 5rpx;
  background: #C41E3A;
  border-radius: 2rpx;
  transition: all 0.25s ease;
}

.notes-list {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx calc(8rpx + env(safe-area-inset-bottom));
}

.notes-empty {
  text-align: center;
  padding: 100rpx 0;
}

.notes-empty .empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.notes-empty text {
  font-size: 28rpx;
  color: #8B9DAF;
}

.note-item {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 5rpx 14rpx rgba(62, 47, 30, 0.07);
}

.note-item-content {
  flex: 1;
}

.note-item-text {
  font-size: 25rpx;
  color: #2C2C2C;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.68;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.note-item-note {
  font-size: 27rpx;
  color: #C41E3A;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
  line-height: 1.56;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.note-item-meta {
  font-size: 22rpx;
  color: #7f8f9c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.note-item-delete {
  padding: 10rpx 18rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: rgba(196, 30, 58, 0.12);
  border: 1rpx solid rgba(196, 30, 58, 0.22);
}

.note-item-delete text {
  font-size: 23rpx;
  color: #C41E3A;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ── 笔记输入弹层 ──────────────────────────── */

.note-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 400;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
}

.note-editor-card {
  width: 100%;
  background: linear-gradient(180deg, #f9f4eb 0%, #f3ebdd 100%);
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 28rpx rgba(0, 0, 0, 0.18);
}

.note-editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.note-editor-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.note-editor-close {
  font-size: 36rpx;
  color: #8B9DAF;
  padding: 8rpx;
}

.note-editor-quote {
  padding: 16rpx 18rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #7f8f9c;
  font-size: 24rpx;
  line-height: 1.6;
}

.note-editor-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(139, 157, 175, 0.18);
  color: #2C2C2C;
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.note-editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.note-editor-cancel,
.note-editor-save {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.note-editor-cancel {
  background: rgba(255, 255, 255, 0.55);
  color: #8B9DAF;
}

.note-editor-save {
  background: linear-gradient(180deg, #C41E3A, #A8182D);
  color: #fff;
}

/* ── 设置面板 ──────────────────────────────── */

.settings-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  pointer-events: none;
}

.settings-panel-open {
  pointer-events: auto;
}

.settings-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.settings-panel-open .settings-overlay {
  opacity: 1;
}

.settings-drawer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: linear-gradient(180deg, #f9f4eb 0%, #f3ebdd 100%);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.35s ease;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.settings-panel-open .settings-drawer {
  transform: translateY(0);
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
}

.settings-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.settings-close {
  font-size: 36rpx;
  color: #8B9DAF;
  padding: 8rpx;
}

.settings-group {
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.1);
}

.settings-label {
  font-size: 26rpx;
  color: #5A5A5A;
  display: block;
  margin-bottom: 14rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.settings-slider {
  margin: 0 -10rpx;
}

.theme-toggle {
  display: flex;
  gap: 16rpx;
}

.theme-option {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 2rpx solid rgba(139, 157, 175, 0.18);
  color: #8B9DAF;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  transition: all 0.25s ease;
}

.theme-option.active {
  background: rgba(196, 30, 58, 0.12);
  color: #C41E3A;
  border-color: rgba(196, 30, 58, 0.35);
  font-weight: 500;
}

/* ── 书签列表（设置面板内）───────────────────── */

.bookmark-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 16rpx;
}

.bookmark-info {
  flex: 1;
}

.bookmark-title {
  font-size: 28rpx;
  color: #2C2C2C;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.bookmark-chapter {
  font-size: 22rpx;
  color: #8B9DAF;
  display: block;
}

.bookmark-delete {
  padding: 8rpx 16rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: rgba(196, 30, 58, 0.1);
  border: 1rpx solid rgba(196, 30, 58, 0.2);
  flex-shrink: 0;
}

.bookmark-delete text {
  font-size: 22rpx;
  color: #C41E3A;
}

/* ── 搜索面板 ──────────────────────────────── */

.search-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(248, 246, 242, 0.98);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 200;
  display: flex;
  flex-direction: column;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
}

.search-panel-open {
  transform: translateY(0);
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.16);
  background: rgba(255, 255, 255, 0.55);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(139, 157, 175, 0.2);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2C2C2C;
}

.search-close {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #C41E3A;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.search-results {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx;
}

.search-result-item {
  display: block;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(62, 47, 30, 0.06);
}

.search-result-item:active {
  transform: scale(0.98);
}

.search-result-title {
  font-size: 28rpx;
  color: #2C2C2C;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.search-result-snippet {
  font-size: 24rpx;
  color: #8B9DAF;
  display: block;
  line-height: 1.6;
}

.search-empty {
  text-align: center;
  padding: 120rpx 0;
}

.search-empty text {
  font-size: 28rpx;
  color: #8B9DAF;
}
