/* pages/reader/reader.wxss */

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 章节导航 */
.chapter-nav {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.2);
  padding: 16rpx 0;
}

.chapter-tabs {
  display: flex;
  padding: 0 32rpx;
  white-space: nowrap;
}

.chapter-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--gray-blue);
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.chapter-tab.active {
  background: var(--vermillion);
  color: #fff;
}

/* 阅读容器 */
.reader-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 章节标题 */
.chapter-header {
  padding: 40rpx 32rpx 20rpx;
  text-align: center;
}

.chapter-number {
  font-size: 24rpx;
  color: var(--gray-blue);
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 8rpx;
}

.chapter-title {
  font-size: 40rpx;
  display: block;
  margin-bottom: 8rpx;
}

.chapter-subtitle {
  font-size: 26rpx;
  color: var(--gray-blue);
  font-style: italic;
}

.chapter-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  gap: 16rpx;
}

.divider-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--amber), transparent);
}

.divider-icon {
  color: var(--vermillion);
  font-size: 20rpx;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  height: 0;
}

.content-body {
  padding: 20rpx 32rpx 160rpx;
}

/* 章节列表 */
.section-list {
  margin-bottom: 32rpx;
}

.section-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}

.section-item:active {
  background: rgba(255, 255, 255, 0.8);
}

.section-bullet {
  font-size: 28rpx;
  margin-right: 20rpx;
  font-weight: 700;
}

.section-content {
  flex: 1;
}

.section-title {
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: var(--ink-black);
  display: block;
}

.section-hint {
  font-size: 22rpx;
  color: var(--gray-blue);
  margin-top: 4rpx;
}

.section-arrow {
  font-size: 32rpx;
  color: var(--gray-blue);
}

/* 正文段落 */
.paragraph {
  margin-bottom: 32rpx;
}

.paragraph-text {
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: var(--ink-black);
  line-height: 2.2;
  text-align: justify;
  text-indent: 2em;
}

/* 章节结尾 */
.chapter-end {
  text-align: center;
  padding: 60rpx 0;
}

.end-text {
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: var(--ink-black);
  display: block;
  margin-bottom: 12rpx;
}

.end-hint {
  font-size: 24rpx;
  color: var(--gray-blue);
}

/* 章节正文内容 */
.chapter-content {
  padding: 0 32rpx 160rpx;
}

.section-header-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 24rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.2);
}

.back-btn {
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
}

.back-btn text {
  font-size: 24rpx;
  color: var(--gray-blue);
}

.current-section-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: var(--ink-black);
  font-weight: 600;
}

/* 小节导航 */
.section-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(139, 157, 175, 0.2);
}

.nav-btn {
  padding: 16rpx 32rpx;
}

.nav-btn text {
  font-size: 26rpx;
}

.nav-placeholder {
  width: 1rpx;
}

.nav-btn.vermillion {
  background: var(--vermillion);
  color: #fff;
}

/* 阅读进度 */
.reading-progress {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: rgba(245, 240, 232, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  border-top: 1rpx solid rgba(139, 157, 175, 0.2);
  z-index: 100;
}

.progress-bar {
  flex: 1;
  height: 6rpx;
  background: rgba(139, 157, 175, 0.2);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--vermillion), var(--amber));
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: var(--gray-blue);
  min-width: 60rpx;
  text-align: right;
}

/* 高亮弹窗 */
.highlight-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.popup-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx;
}

.popup-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: var(--ink-black);
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}

.popup-actions {
  display: flex;
  gap: 16rpx;
}

.popup-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 16rpx;
}

.popup-btn text {
  font-size: 26rpx;
}
