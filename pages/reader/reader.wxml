<!--pages/reader/reader.wxml-->
<view class="page-container paper-bg">
  <!-- 章节导航 -->
  <scroll-view 
    class="chapter-nav" 
    scroll-x 
    enhanced 
    show-scrollbar="{{false}}"
  >
    <view class="chapter-tabs">
      <view 
        class="chapter-tab {{activeChapter === index ? 'active' : ''}}" 
        wx:for="{{chapters}}" 
        wx:key="id"
        bindtap="onChapterTap"
        data-index="{{index}}"
      >
        <text>{{item.title}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 阅读区域 -->
  <view class="reader-container">
    <!-- 小节列表模式 -->
    <block wx:if="{{activeSection === -1}}">
      <!-- 章节标题 -->
      <view class="chapter-header scale-fade-in">
        <text class="chapter-number">第{{activeChapter + 1}}章</text>
        <text class="chapter-title title-text">{{currentChapter.title}}</text>
        <text class="chapter-subtitle">{{currentChapter.subtitle}}</text>
        <view class="chapter-divider">
          <view class="divider-line"></view>
          <text class="divider-icon">✦</text>
          <view class="divider-line"></view>
        </view>
      </view>
      
      <!-- 小节列表 -->
      <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="section-list">
          <view 
            class="section-item scale-fade-in" 
            wx:for="{{currentSections}}" 
            wx:key="id"
            bindtap="onSectionTap"
            data-index="{{index}}"
            style="animation-delay: {{index * 0.05}}s"
          >
            <view class="section-bullet vermillion">§</view>
            <view class="section-content">
              <text class="section-title">{{item.title}}</text>
              <text class="section-hint">{{item.paragraphs.length}} 段 · 点击阅读</text>
            </view>
            <view class="section-arrow">›</view>
          </view>
        </view>
        <view class="chapter-end" wx:if="{{currentSections.length === 0 && !isLoading}}">
          <text class="end-text">内容加载中...</text>
        </view>
      </scroll-view>
    </block>

    <!-- 正文阅读模式 -->
    <block wx:else>
      <view class="section-header-bar glass-card">
        <view class="back-btn" bindtap="onBackToSections">
          <text>← 返回目录</text>
        </view>
        <text class="current-section-title">{{currentSections[activeSection].title}}</text>
      </view>
      <reader-view
        id="readerView"
        chapterTitle="{{currentChapter.title}}"
        sectionTitle="{{currentSections[activeSection].title}}"
        paragraphs="{{currentSections[activeSection].paragraphs}}"
        hasPrev="{{activeSection > 0}}"
        hasNext="{{activeSection < currentSections.length - 1}}"
        bind:select="onTextSelect"
        bind:prev="onPrevSection"
        bind:next="onNextSection"
        bind:progress="onReadProgress"
      />
    </block>
  </view>

  <!-- 高亮/批注弹窗 -->
  <view class="highlight-popup" wx:if="{{showHighlightPopup}}">
    <view class="popup-mask" bindtap="onPopupClose"></view>
    <view class="popup-content glass-card">
      <text class="popup-title">选择操作</text>
      <view class="popup-actions">
        <view class="popup-btn glass-btn" bindtap="onHighlight">
          <text>🖍️ 划线高亮</text>
        </view>
        <view class="popup-btn glass-btn" bindtap="onAddNote">
          <text>📝 写笔记</text>
        </view>
        <view class="popup-btn glass-btn" bindtap="onCopyText">
          <text>📋 复制文字</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 笔记/高亮入口按钮 -->
  <view class="notes-fab glass-btn" bindtap="onOpenNotesPanel">
    <text class="notes-fab-icon">📒</text>
  </view>

  <!-- 笔记/高亮列表面板 -->
  <view class="notes-panel-overlay" wx:if="{{showNotesPanel}}">
    <view class="notes-panel-mask" bindtap="onCloseNotesPanel"></view>
    <view class="notes-panel glass-card" catchtouchmove="onPanelTouchMove">
      <!-- 面板头部 -->
      <view class="notes-panel-header">
        <text class="notes-panel-title title-text">我的笔记</text>
        <view class="notes-panel-close" bindtap="onCloseNotesPanel">
          <text>✕</text>
        </view>
      </view>

      <!-- Tab 切换 -->
      <view class="notes-tabs">
        <view 
          class="notes-tab {{notesPanelTab === 'highlights' ? 'active' : ''}}" 
          bindtap="onNotesPanelTabChange" 
          data-tab="highlights"
        >
          <text>🖍️ 高亮 ({{highlightsList.length}})</text>
        </view>
        <view 
          class="notes-tab {{notesPanelTab === 'notes' ? 'active' : ''}}" 
          bindtap="onNotesPanelTabChange" 
          data-tab="notes"
        >
          <text>📝 笔记 ({{notesList.length}})</text>
        </view>
      </view>

      <!-- 高亮列表 -->
      <scroll-view class="notes-list-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{notesPanelTab === 'highlights'}}">
        <block wx:if="{{highlightsList.length > 0}}">
          <view 
            class="note-item glass-card" 
            wx:for="{{highlightsList}}" 
            wx:key="id"
          >
            <view class="note-item-body" bindtap="onJumpToHighlight" data-index="{{index}}">
              <text class="note-item-text">"{{item.text}}"</text>
              <view class="note-item-meta">
                <text class="note-item-chapter">📖 {{item.chapter}}</text>
                <text class="note-item-time">{{item.timeFormatted}}</text>
              </view>
            </view>
            <view class="note-item-delete" bindtap="onDeleteHighlight" data-index="{{index}}">
              <text class="delete-icon">🗑️</text>
            </view>
          </view>
        </block>
        <view class="notes-empty" wx:else>
          <text class="notes-empty-icon">🖍️</text>
          <text class="notes-empty-text">还没有高亮</text>
          <text class="notes-empty-hint">长按文字即可划线高亮</text>
        </view>
      </scroll-view>

      <!-- 笔记列表 -->
      <scroll-view class="notes-list-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{notesPanelTab === 'notes'}}">
        <block wx:if="{{notesList.length > 0}}">
          <view 
            class="note-item glass-card" 
            wx:for="{{notesList}}" 
            wx:key="id"
          >
            <view class="note-item-body" bindtap="onJumpToHighlight" data-index="{{index}}">
              <text class="note-item-quote">"{{item.text}}"</text>
              <text class="note-item-note">💡 {{item.note}}</text>
              <view class="note-item-meta">
                <text class="note-item-chapter">📖 {{item.chapter}}</text>
                <text class="note-item-time">{{item.timeFormatted}}</text>
              </view>
            </view>
            <view class="note-item-delete" bindtap="onDeleteNote" data-index="{{index}}">
              <text class="delete-icon">🗑️</text>
            </view>
          </view>
        </block>
        <view class="notes-empty" wx:else>
          <text class="notes-empty-icon">📝</text>
          <text class="notes-empty-text">还没有笔记</text>
          <text class="notes-empty-hint">选中文字后点击"写笔记"开始记录</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
