<view class="reader-page page-enter {{theme === 'dark' ? 'dark' : ''}}">
  <!-- 章节导航 -->
  <scroll-view class="chapter-nav" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view
      wx:for="{{chapters}}"
      wx:key="id"
      class="chapter-tab {{activeChapter === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onChapterTap"
    >
      <text>{{item.title}}</text>
    </view>
  </scroll-view>

  <!-- 章节标题（列表模式） -->
  <view class="chapter-header" wx:if="{{chapters[activeChapter] && mode === 'list'}}">
    <text class="chapter-title">{{chapters[activeChapter].title}}</text>
    <text class="chapter-subtitle">{{chapters[activeChapter].subtitle}}</text>
  </view>

  <!-- 小节列表 -->
  <view class="section-list" wx:if="{{mode === 'list'}}">
    <view
      wx:if="{{chapters[activeChapter]}}"
      wx:for="{{chapters[activeChapter].sections}}"
      wx:key="id"
      class="section-item glass"
      data-id="{{item.id}}"
      bindtap="onSectionTap"
    >
      <view class="section-index">{{index + 1}}</view>
      <view class="section-info">
        <text class="section-name">{{item.title}}</text>
      </view>
      <text class="section-arrow">›</text>
    </view>
  </view>

  <!-- 正文阅读模式 -->
  <view class="reading-mode" wx:if="{{mode === 'reading'}}">
    <view class="reading-toolbar">
      <view class="back-btn" bindtap="onBackToList"><text>‹ 返回</text></view>
      <text class="reading-title" wx:if="{{currentSection}}">{{currentSection.title}}</text>
      <view class="toolbar-actions">
        <view class="toolbar-btn" bindtap="onToggleSearch"><text>🔍</text></view>
        <view class="toolbar-btn {{isCurrentBookmarked ? 'bookmarked' : ''}}" bindtap="onToggleBookmark"><text>{{isCurrentBookmarked ? '★' : '☆'}}</text></view>
        <view class="toolbar-btn" bindtap="onToggleSettings"><text>⚙</text></view>
      </view>
    </view>

    <view class="reading-progress-wrap">
      <view class="reading-progress-bar" style="width: {{readingProgress}}%;"></view>
    </view>
    <view class="reading-tip">
      <text>可长按正文唤起笔记操作；也可按住文字使用系统选择复制</text>
    </view>

    <scroll-view
      class="reading-scroll"
      style="height: {{readingScrollHeight}}px;"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      scroll-top="{{readingScrollTop}}"
      lower-threshold="16"
      bindscroll="onReadingScroll"
      bindscrolltolower="onReadingScrollToLower"
    >
      <reader-view
        paragraphs="{{sectionParagraphs}}"
        fontSize="{{fontSize}}"
        lineHeight="{{lineHeight}}"
        paragraphSpacing="{{paragraphSpacing}}"
        theme="{{theme}}"
        bind:highlight="onHighlight"
        bind:note="onNote"
      />
    </scroll-view>

    <view class="bottom-nav">
      <view class="bottom-nav-btn {{prevSection ? '' : 'disabled'}}" bindtap="onPrevSection"><text>‹ 上一节</text></view>
      <view class="bottom-nav-progress"><text>{{readingProgress}}% · {{readMinutes}}分钟读完</text></view>
      <view class="bottom-nav-btn {{nextSection ? '' : 'disabled'}}" bindtap="onNextSection"><text>下一节 ›</text></view>
    </view>
  </view>

  <!-- 笔记浮动按钮 -->
  <view class="notes-fab {{showNotesPanel ? 'notes-fab-hidden' : ''}}" wx:if="{{mode === 'reading'}}" bindtap="onToggleNotesPanel">
    <text>📝</text>
  </view>

  <!-- 笔记面板 -->
  <view class="notes-panel {{showNotesPanel ? 'notes-panel-open' : ''}}">
    <view class="notes-overlay" bindtap="onCloseNotesPanel"></view>
    <view class="notes-drawer">
      <view class="notes-header">
        <text class="notes-title">阅读笔记</text>
        <text class="notes-close" bindtap="onCloseNotesPanel">✕</text>
      </view>
      <view class="notes-summary"><text>共 {{highlights.length + notes.length}} 条记录</text></view>
      <view class="notes-tabs">
        <view class="notes-tab {{notesTab === 'highlights' ? 'active' : ''}}" data-tab="highlights" bindtap="onNotesTabChange"><text>高亮 ({{highlights.length}})</text></view>
        <view class="notes-tab {{notesTab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="onNotesTabChange"><text>笔记 ({{notes.length}})</text></view>
      </view>
      <scroll-view class="notes-list" scroll-y="{{true}}" wx:if="{{notesTab === 'highlights'}}">
        <view wx:if="{{highlights.length === 0}}" class="notes-empty"><text class="empty-icon">🖍</text><text>长按正文即可高亮</text></view>
        <view wx:for="{{highlights}}" wx:key="id" class="note-item">
          <view class="note-item-content" data-chapter="{{item.chapterIndex}}" data-section="{{item.sectionId}}" bindtap="onJumpToHighlight">
            <text class="note-item-text" user-select="{{true}}">{{item.text}}</text>
            <text class="note-item-meta">{{item.sectionTitle}}</text>
          </view>
          <view class="note-item-delete" data-id="{{item.id}}" catchtap="onDeleteHighlight"><text>删除</text></view>
        </view>
      </scroll-view>
      <scroll-view class="notes-list" scroll-y="{{true}}" wx:if="{{notesTab === 'notes'}}">
        <view wx:if="{{notes.length === 0}}" class="notes-empty"><text class="empty-icon">📝</text><text>长按正文添加笔记</text></view>
        <view wx:for="{{notes}}" wx:key="id" class="note-item">
          <view class="note-item-content" data-chapter="{{item.chapterIndex}}" data-section="{{item.sectionId}}" bindtap="onJumpToNote">
            <text class="note-item-note" user-select="{{true}}">{{item.note}}</text>
            <text class="note-item-text" user-select="{{true}}">{{item.text}}</text>
            <text class="note-item-meta">{{item.sectionTitle}}</text>
          </view>
          <view class="note-item-delete" data-id="{{item.id}}" catchtap="onDeleteNote"><text>删除</text></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 笔记输入弹层 -->
  <view class="note-editor-mask" wx:if="{{showNoteEditor}}" catchtap="onCloseNoteEditor">
    <view class="note-editor-card" catchtap="noop">
      <view class="note-editor-header">
        <text class="note-editor-title">添加笔记</text>
        <text class="note-editor-close" bindtap="onCloseNoteEditor">✕</text>
      </view>
      <view class="note-editor-quote"><text>{{noteSelectedText}}</text></view>
      <textarea class="note-editor-input" value="{{noteDraft}}" placeholder="输入你的笔记..." maxlength="500" auto-height="true" bindinput="onNoteDraftInput" />
      <view class="note-editor-actions">
        <view class="note-editor-cancel" bindtap="onCloseNoteEditor"><text>取消</text></view>
        <view class="note-editor-save" bindtap="onSaveNote"><text>保存</text></view>
      </view>
    </view>
  </view>

  <!-- 设置面板 -->
  <view class="settings-panel {{showSettings ? 'settings-panel-open' : ''}}">
    <view class="settings-overlay" bindtap="onCloseSettings"></view>
    <view class="settings-drawer">
      <view class="settings-header">
        <text class="settings-title">阅读设置</text>
        <text class="settings-close" bindtap="onCloseSettings">✕</text>
      </view>
      <view class="settings-group">
        <text class="settings-label">字号：{{fontSize}}</text>
        <slider class="settings-slider" min="24" max="40" step="2" value="{{fontSize}}" bindchange="onFontSizeChange" activeColor="#C41E3A" />
      </view>
      <view class="settings-group">
        <text class="settings-label">行高：{{lineHeight}}</text>
        <slider class="settings-slider" min="16" max="28" step="1" value="{{lineHeightSlider}}" bindchange="onLineHeightChange" activeColor="#C41E3A" />
      </view>
      <view class="settings-group">
        <text class="settings-label">段落间距：{{paragraphSpacing}}</text>
        <slider class="settings-slider" min="16" max="48" step="2" value="{{paragraphSpacing}}" bindchange="onParagraphSpacingChange" activeColor="#C41E3A" />
      </view>
      <view class="settings-group">
        <text class="settings-label">主题</text>
        <view class="theme-toggle" bindtap="onThemeToggle">
          <view class="theme-option {{theme === 'paper' ? 'active' : ''}}"><text>纸韵</text></view>
          <view class="theme-option {{theme === 'dark' ? 'active' : ''}}"><text>深色</text></view>
        </view>
      </view>
      <view class="settings-group" wx:if="{{bookmarks.length > 0}}">
        <text class="settings-label">书签</text>
        <view wx:for="{{bookmarks}}" wx:key="id" class="bookmark-item">
          <view class="bookmark-info" data-chapterindex="{{item.chapterIndex}}" data-sectionid="{{item.sectionId}}" bindtap="onBookmarkTap">
            <text class="bookmark-title">{{item.sectionTitle}}</text>
            <text class="bookmark-chapter">{{item.chapterTitle}}</text>
          </view>
          <view class="bookmark-delete" data-id="{{item.id}}" catchtap="onDeleteBookmark"><text>删除</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索面板 -->
  <view class="search-panel {{showSearch ? 'search-panel-open' : ''}}">
    <view class="search-header">
      <input class="search-input" value="{{searchQuery}}" placeholder="搜索全文..." bindinput="onSearchInput" focus="{{showSearch}}" />
      <text class="search-close" bindtap="onCloseSearch">取消</text>
    </view>
    <scroll-view class="search-results" scroll-y="{{true}}" wx:if="{{searchResults.length > 0}}">
      <view wx:for="{{searchResults}}" wx:key="index" class="search-result-item" data-chapterindex="{{item.chapterIndex}}" data-sectionid="{{item.sectionId}}" bindtap="onSearchResultTap">
        <text class="search-result-title">{{item.sectionTitle}}</text>
        <text class="search-result-snippet">{{item.snippet}}</text>
      </view>
    </scroll-view>
    <view class="search-empty" wx:if="{{searchQuery.length >= 2 && searchResults.length === 0}}"><text>未找到相关结果</text></view>
  </view>
</view>
