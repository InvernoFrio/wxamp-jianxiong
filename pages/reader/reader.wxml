<!--pages/reader/reader.wxml-->
<view class="page-container paper-bg">
  <!-- 章节导航 -->
  <scroll-view 
    class="chapter-nav" 
    scroll-x 
    enhanced 
    show-scrollbar="{{false}}"
  >
    <view class="chapter-tabs">
      <view 
        class="chapter-tab {{activeChapter === index ? 'active' : ''}}" 
        wx:for="{{chapters}}" 
        wx:key="id"
        bindtap="onChapterTap"
        data-index="{{index}}"
      >
        <text>{{item.title}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 阅读区域 -->
  <view class="reader-container">
    <!-- 小节列表模式 -->
    <block wx:if="{{activeSection === -1}}">
      <!-- 章节标题 -->
      <view class="chapter-header scale-fade-in">
        <text class="chapter-number">第{{activeChapter + 1}}章</text>
        <text class="chapter-title title-text">{{currentChapter.title}}</text>
        <text class="chapter-subtitle">{{currentChapter.subtitle}}</text>
        <view class="chapter-divider">
          <view class="divider-line"></view>
          <text class="divider-icon">✦</text>
          <view class="divider-line"></view>
        </view>
      </view>
      
      <!-- 小节列表 -->
      <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="section-list">
          <view 
            class="section-item scale-fade-in" 
            wx:for="{{currentSections}}" 
            wx:key="id"
            bindtap="onSectionTap"
            data-index="{{index}}"
            style="animation-delay: {{index * 0.05}}s"
          >
            <view class="section-bullet vermillion">§</view>
            <view class="section-content">
              <text class="section-title">{{item.title}}</text>
              <text class="section-hint">{{item.paragraphs.length}} 段 · 点击阅读</text>
            </view>
            <view class="section-arrow">›</view>
          </view>
        </view>
        <view class="chapter-end" wx:if="{{currentSections.length === 0 && !isLoading}}">
          <text class="end-text">内容加载中...</text>
        </view>
      </scroll-view>
    </block>

    <!-- 正文阅读模式 -->
    <block wx:else>
      <view class="section-header-bar glass-card">
        <view class="back-btn" bindtap="onBackToSections">
          <text>← 返回目录</text>
        </view>
        <text class="current-section-title">{{currentSections[activeSection].title}}</text>
      </view>
      <reader-view
        id="readerView"
        chapterTitle="{{currentChapter.title}}"
        sectionTitle="{{currentSections[activeSection].title}}"
        paragraphs="{{currentSections[activeSection].paragraphs}}"
        hasPrev="{{activeSection > 0}}"
        hasNext="{{activeSection < currentSections.length - 1}}"
        bind:select="onTextSelect"
        bind:prev="onPrevSection"
        bind:next="onNextSection"
        bind:progress="onReadProgress"
      />
    </block>
  </view>

  <!-- 高亮/批注弹窗 -->
  <view class="highlight-popup" wx:if="{{showHighlightPopup}}">
    <view class="popup-mask" bindtap="onPopupClose"></view>
    <view class="popup-content glass-card">
      <text class="popup-title">选择操作</text>
      <view class="popup-actions">
        <view class="popup-btn glass-btn" bindtap="onHighlight">
          <text>🖍️ 划线高亮</text>
        </view>
        <view class="popup-btn glass-btn" bindtap="onAddNote">
          <text>📝 写笔记</text>
        </view>
        <view class="popup-btn glass-btn" bindtap="onCopyText">
          <text>📋 复制文字</text>
        </view>
      </view>
    </view>
  </view>
</view>
