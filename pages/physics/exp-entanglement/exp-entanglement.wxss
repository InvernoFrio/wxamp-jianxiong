/* pages/physics/exp-entanglement/exp-entanglement.wxss */

/* =========================
   基础页面背景（量子深空风）
========================= */
.physics-page {
  min-height: 100vh;
  padding: 20rpx 24rpx;
  padding-bottom: 140rpx;

  background:
    radial-gradient(circle at 20% 10%, rgba(79,195,247,0.16), transparent 35%),
    radial-gradient(circle at 80% 90%, rgba(196,30,58,0.12), transparent 40%),
    radial-gradient(circle at 50% 50%, rgba(165, 165, 255, 0.06), transparent 60%),
    linear-gradient(180deg, #070b1a 0%, #0b1020 50%, #0a0f1d 100%);
  color: #e8f1ff;
}

/* =========================
   步骤指示器
========================= */
.step-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(200, 220, 255, 0.25);
  transition: all 0.3s ease;
}

.step-dot.active {
  background: #4FC3F7;
  transform: scale(1.35);
  box-shadow: 0 0 0 10rpx rgba(79,195,247,0.12);
}

/* =========================
   step 内容
========================= */
.step-content {
  animation: fadeInUp 0.45s ease-out;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 12rpx;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* =========================
   step 标题区
========================= */
.step-hero {
  text-align: center;
  padding: 26rpx 0 40rpx;
}

.hero-icon {
  font-size: 70rpx;
  display: block;
  margin-bottom: 14rpx;
  filter: drop-shadow(0 0 10rpx rgba(79,195,247,0.4));
}

.hero-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #eaf3ff;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 10rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.hero-desc {
  font-size: 26rpx;
  color: rgba(200,220,255,0.6);
}

/* =========================
   glass 卡片（保持原有）
========================= */
glass-card {
  display: block;
  padding: 28rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.25), inset 0 1rpx 0 rgba(255,255,255,0.05);
}

.intro-text {
  font-size: 28rpx;
  line-height: 2.0;
  color: rgba(230,240,255,0.85);
}

/* =========================
   实验区 Canvas
========================= */
.canvas-container {
  width: 100%;
  height: 460rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: radial-gradient(circle at center, rgba(79,195,247,0.08), rgba(0,0,0,0.4));
  border: 1rpx solid rgba(79,195,247,0.25);
  box-shadow: 0 18rpx 40rpx rgba(0,0,0,0.35), inset 0 0 40rpx rgba(79,195,247,0.08);
}

.physics-canvas {
  width: 100%;
  height: 100%;
}

/* =========================
   通用 glass 面板
========================= */
.glass {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
  border-radius: 24rpx;
  padding: 28rpx;
}

/* 面板公共 header */
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: bold;
  color: rgba(200,220,255,0.85);
}

.info-icon-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(79,195,247,0.15);
  border: 1rpx solid rgba(79,195,247,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-icon {
  font-size: 22rpx;
  color: #4FC3F7;
  font-style: italic;
  font-weight: bold;
}

/* =========================
   步骤引导 Banner
========================= */
.guide-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.guide-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.guide-text {
  font-size: 24rpx;
  color: rgba(200,220,255,0.8);
  line-height: 1.6;
}

/* =========================
   偏振片角度控制面板
========================= */
.polarizer-panel {
  /* 继承 .glass */
}

.angle-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.angle-label-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  width: 80rpx;
}

.detector-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.detector-a {
  background: rgba(79,195,247,0.2);
  border: 1rpx solid rgba(79,195,247,0.5);
  color: #4FC3F7;
}

.detector-b {
  background: rgba(196,30,58,0.2);
  border: 1rpx solid rgba(196,30,58,0.5);
  color: #C41E3A;
}

.angle-value {
  font-size: 22rpx;
  font-weight: bold;
  color: #eaf3ff;
}

.angle-slider {
  flex: 1;
}

/* 角度联动建议行 */
.suggest-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
}

.suggest-label {
  font-size: 22rpx;
  color: rgba(200,220,255,0.5);
  flex: 1;
}

.suggest-btn {
  padding: 10rpx 26rpx;
  border-radius: 14rpx;
  background: rgba(79,195,247,0.15);
  border: 1rpx solid rgba(79,195,247,0.3);
}

.suggest-btn text {
  font-size: 22rpx;
  color: #4FC3F7;
}

/* =========================
   实时符合率面板
========================= */
.coinc-panel {
  /* 继承 .glass */
}

.coinc-formula {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.formula-text {
  font-size: 26rpx;
  color: rgba(200,220,255,0.75);
}

.formula-sub {
  font-size: 20rpx;
  color: rgba(200,220,255,0.5);
  vertical-align: sub;
}

.formula-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #4FC3F7;
}

/* 符合率进度条 */
.coinc-bar-track {
  height: 20rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 10rpx;
  overflow: visible;
  position: relative;
  margin-bottom: 12rpx;
}

.coinc-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.4s ease;
}

.coinc-bar-fill.quantum {
  background: linear-gradient(90deg, #4FC3F7, #29B6F6);
}

/* 经典上限 50% 标记竖线 */
.coinc-bar-classic-limit {
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 3rpx;
  height: 36rpx;
  background: #C41E3A;
  border-radius: 2rpx;
  opacity: 0.8;
}

.coinc-bar-legend {
  display: flex;
  justify-content: space-between;
}

.legend-quantum {
  font-size: 20rpx;
  color: #4FC3F7;
}

.legend-classic {
  font-size: 20rpx;
  color: #C41E3A;
}

/* =========================
   cos² 曲线（柱状近似）
========================= */
.curve-section {
  /* 继承 .glass */
}

.curve-chart {
  display: flex;
  align-items: flex-end;
  height: 100rpx;
  gap: 3rpx;
  padding: 0 4rpx;
  margin-bottom: 8rpx;
  position: relative;
}

.curve-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  position: relative;
}

.curve-bar-q {
  width: 100%;
  min-height: 2rpx;
  background: rgba(79,195,247,0.55);
  border-radius: 2rpx 2rpx 0 0;
  transition: height 0.3s ease;
}

/* 经典上限参考线：固定在柱图 50% 高度处 */
.curve-bar-c {
  position: absolute;
  bottom: 45rpx;  /* = 100rpx * 50% */
  width: 100%;
  height: 1rpx;
  background: rgba(196,30,58,0.4);
}

/* 当前角度差对应的柱高亮 */
.curve-col-active .curve-bar-q {
  background: #FFD54F;
  box-shadow: 0 0 8rpx rgba(255,213,79,0.5);
}

/* 坐标轴 */
.curve-axis {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx;
  margin-bottom: 16rpx;
}

.curve-axis text {
  font-size: 18rpx;
  color: rgba(200,220,255,0.4);
}

/* 图例 */
.curve-legend {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.curve-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.curve-legend-item text {
  font-size: 20rpx;
  color: rgba(200,220,255,0.55);
}

.curve-legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
}

.quantum-dot  { background: rgba(79,195,247,0.8); }
.classic-dot  { background: rgba(196,30,58,0.7); }
.active-dot   { background: #FFD54F; }

/* =========================
   统计面板（保持原有，改标签）
========================= */
.stats-panel {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  backdrop-filter: blur(14rpx);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(200,220,255,0.6);
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 38rpx;
  font-weight: bold;
  color: #eaf3ff;
}

.stat-coinc { color: #4FC3F7; }
.stat-miss  { color: #FF5252; }

/* =========================
   贝尔 S 参数面板
========================= */
.bell-panel {
  /* 继承 .glass */
}

.bell-s-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.bell-s-value {
  font-size: 40rpx;
  font-weight: bold;
}

.bell-violated { color: #4FC3F7; }
.bell-ok       { color: rgba(200,220,255,0.5); }

.bell-verdict {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.verdict-violated {
  background: rgba(79,195,247,0.15);
  border: 1rpx solid rgba(79,195,247,0.3);
  color: #4FC3F7;
}

.verdict-ok {
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.1);
  color: rgba(200,220,255,0.5);
}

/* 贝尔 S 进度条 */
.bell-limit-bar {
  height: 14rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 7rpx;
  position: relative;
  overflow: visible;
}

.bell-limit-fill {
  height: 100%;
  background: linear-gradient(90deg, #4FC3F7, #29B6F6);
  border-radius: 7rpx;
  transition: width 0.5s ease;
  max-width: 100%;
}

/* 经典极限标记 */
.bell-limit-mark {
  position: absolute;
  left: 70.7%;   /* 2 / 2.828 = 70.7% */
  top: -28rpx;
  transform: translateX(-50%);
}

.bell-limit-label {
  font-size: 18rpx;
  color: rgba(196,30,58,0.8);
  white-space: nowrap;
}

/* =========================
   控制按钮区域
========================= */
.controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.ctrl-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 18rpx;
  text-align: center;
  font-size: 26rpx;
}

.reset-btn {
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  color: rgba(200,220,255,0.7);
}

.share-btn {
  background: rgba(79,195,247,0.08);
  border: 1rpx solid rgba(79,195,247,0.2);
  color: #4FC3F7;
}

.ctrl-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* =========================
   结果面板（保持原有）
========================= */
.result-panel { margin-top: 20rpx; }

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4FC3F7;
  display: block;
  margin-bottom: 18rpx;
}

.result-bar {
  display: flex;
  height: 46rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.result-bar-same {
  background: linear-gradient(90deg, #4FC3F7, #29B6F6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.5s ease;
}

.result-bar-diff {
  background: linear-gradient(90deg, #FF5252, #C41E3A);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.5s ease;
}

.bar-label {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}

.result-desc {
  font-size: 26rpx;
  color: rgba(200,220,255,0.7);
  line-height: 1.8;
}

/* =========================
   步骤导航
========================= */
.step-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
}

.nav-btn {
  padding: 16rpx 34rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  color: #4FC3F7;
  font-size: 28rpx;
}

.nav-btn:active {
  transform: scale(0.95);
  background: rgba(79,195,247,0.1);
}

.nav-placeholder { width: 120rpx; }

.nav-next {
  border-color: rgba(79,195,247,0.3);
  background: rgba(79,195,247,0.08);
}

/* =========================
   原理弹窗
========================= */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 86%;
  background: #0f1a2e;
  border: 1rpx solid rgba(79,195,247,0.25);
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 0 60rpx rgba(79,195,247,0.12);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4FC3F7;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.modal-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-btn text {
  font-size: 24rpx;
  color: rgba(200,220,255,0.6);
}

.modal-text {
  font-size: 26rpx;
  line-height: 1.9;
  color: rgba(200,220,255,0.75);
  display: block;
  margin-bottom: 16rpx;
}

.modal-formula {
  display: flex;
  align-items: baseline;
  justify-content: center;
  background: rgba(79,195,247,0.08);
  border: 1rpx solid rgba(79,195,247,0.2);
  border-radius: 16rpx;
  padding: 18rpx 28rpx;
  margin: 16rpx 0;
}

.modal-formula text {
  font-size: 30rpx;
  color: #eaf3ff;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.formula-sub-sm {
  font-size: 22rpx !important;
  color: rgba(200,220,255,0.6) !important;
  vertical-align: sub;
}

