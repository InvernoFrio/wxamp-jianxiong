/* pages/physics/physics.wxss */

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

.page-header {
  padding: 40rpx 32rpx 20rpx;
  text-align: center;
}

.page-title {
  font-size: 44rpx;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--gray-blue);
  margin-top: 8rpx;
}

/* 实验流程导航 */
.experiment-nav {
  display: flex;
  justify-content: center;
  padding: 20rpx 32rpx;
  gap: 8rpx;
}

.exp-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.4;
  transition: all 0.3s ease;
}

.exp-step.active {
  opacity: 1;
}

.exp-step.current .step-dot {
  background: var(--vermillion);
  color: #fff;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: rgba(139, 157, 175, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--gray-blue);
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.exp-step.active .step-dot {
  background: var(--amber);
  color: #fff;
}

.step-label {
  font-size: 20rpx;
  color: var(--gray-blue);
}

/* 步骤内容 */
.step-content {
  display: none;
  padding: 20rpx 32rpx;
}

.step-content.visible {
  display: block;
}

/* 介绍卡片 */
.intro-card, .concept-card, .conclusion-card {
  padding: 40rpx;
}

.intro-title, .concept-title, .conclusion-title {
  font-size: 36rpx;
  display: block;
  margin-bottom: 24rpx;
  text-align: center;
}

.intro-text {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--ink-black);
  line-height: 2;
  text-indent: 2em;
  display: block;
  margin-bottom: 20rpx;
}

/* 镜像演示 */
.mirror-demo {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  margin: 20rpx 0;
}

.mirror-left, .mirror-right {
  width: 160rpx;
  height: 160rpx;
  background: rgba(139, 157, 175, 0.1);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.mirror-right {
  transform: scaleX(-1);
}

.demo-ball {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background: var(--vermillion);
  margin-bottom: 16rpx;
}

.demo-arrow-up {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid var(--ink-black);
}

.mirror-line {
  width: 4rpx;
  height: 120rpx;
  background: linear-gradient(180deg, transparent, var(--gray-blue), transparent);
  margin: 0 24rpx;
}

.concept-desc {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--ink-black);
  line-height: 2;
  text-align: center;
}

/* 实验可视化 */
.experiment-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.experiment-canvas {
  width: 100%;
  height: 500rpx;
  background: rgba(44, 44, 44, 0.05);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
}

.experiment-controls {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.control-btn {
  padding: 20rpx 32rpx;
}

.control-btn text {
  font-size: 28rpx;
}

/* 实验说明 */
.experiment-info {
  width: 100%;
}

.info-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: var(--ink-black);
  display: block;
  margin-bottom: 20rpx;
  text-align: center;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
  line-height: 1.8;
}

.info-label {
  font-size: 26rpx;
  color: var(--vermillion);
  flex-shrink: 0;
  font-weight: 600;
}

.info-value {
  font-size: 26rpx;
  color: var(--ink-black);
}

/* 结论卡片 */
.conclusion-icon {
  font-size: 64rpx;
  text-align: center;
  display: block;
  margin-bottom: 16rpx;
}

.conclusion-text {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--ink-black);
  line-height: 2;
  text-indent: 2em;
  display: block;
  margin-bottom: 20rpx;
}

.conclusion-quote {
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(196, 30, 58, 0.05);
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--vermillion);
}

.quote-mark {
  font-family: var(--font-serif);
  font-size: 48rpx;
  color: var(--vermillion);
  line-height: 1;
}

.quote-text {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--ink-black);
  line-height: 1.8;
  display: block;
}

.quote-author {
  font-size: 24rpx;
  color: var(--gray-blue);
  margin-top: 12rpx;
  text-align: right;
  display: block;
}

/* 步骤控制 */
.step-controls {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: rgba(245, 240, 232, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1rpx solid rgba(139, 157, 175, 0.2);
  z-index: 50;
}

.step-btn {
  padding: 20rpx 40rpx;
}

.step-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.step-btn.vermillion {
  background: var(--vermillion);
  color: #fff;
}
