.physics-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 92% -2%, rgba(196, 30, 58, 0.13), transparent 30%),
    radial-gradient(circle at 6% 96%, rgba(79, 195, 247, 0.16), transparent 34%),
    linear-gradient(180deg, #f8f3eb 0%, #f5f0e8 55%, #efe6da 100%);
  padding: 20rpx 24rpx;
  padding-bottom: 120rpx;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(139, 157, 175, 0.28);
  transition: all 0.3s ease;
}

.step-dot.active {
  background: #C41E3A;
  transform: scale(1.34);
  box-shadow: 0 0 0 10rpx rgba(196, 30, 58, 0.12);
}

/* 步骤内容 */
.step-content {
  animation: fadeInUp 0.4s ease-out;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.step-hero {
  text-align: center;
  padding: 30rpx 0 36rpx;
}

.hero-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.hero-desc {
  font-size: 26rpx;
  color: #8B9DAF;
}

.intro-text {
  font-size: 28rpx;
  color: #2C2C2C;
  line-height: 2;
  display: block;
}

.quote-text {
  color: #C41E3A;
  font-style: italic;
  text-align: center;
  padding: 8rpx 16rpx;
}

.quote-card {
  border-color: rgba(196, 30, 58, 0.2);
  background: rgba(196, 30, 58, 0.04);
}

/* 实验步骤 */
.experiment-step {
  display: flex;
  flex-direction: column;
}

.canvas-container {
  width: 100%;
  height: 430rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(37, 28, 22, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
}

.physics-canvas {
  width: 100%;
  height: 100%;
}

/* 统计面板 */
.stats-panel {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 26rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #8B9DAF;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.stat-up {
  color: #4FC3F7;
}

.stat-down {
  color: #C41E3A;
}

/* 控制按钮 */
.controls {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* 结果面板 */
.result-panel {
  margin-top: 16rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #C41E3A;
  display: block;
  margin-bottom: 12rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  display: block;
}

/* 步骤导航 */
.step-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-placeholder {
  width: 120rpx;
}

.nav-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(139, 157, 175, 0.24);
  border-radius: 20rpx;
}

.nav-btn text {
  font-size: 28rpx;
  color: #C41E3A;
}

.nav-btn:active {
  transform: scale(0.96);
  transition: transform 0.2s ease;
}

.nav-next {
  background: rgba(196, 30, 58, 0.1);
  border-color: rgba(196, 30, 58, 0.3);
}
