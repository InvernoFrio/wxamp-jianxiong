.physics-page {
  min-height: 100vh;
  background: #F5F0E8;
  padding: 20rpx 24rpx;
  padding-bottom: 120rpx;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(139, 157, 175, 0.3);
  transition: all 0.3s ease;
}

.step-dot.active {
  background: #C41E3A;
  transform: scale(1.3);
}

/* 步骤内容 */
.step-content {
  animation: fadeInUp 0.4s ease-out;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.step-hero {
  text-align: center;
  padding: 40rpx 0;
}

.hero-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #8B9DAF;
}

.intro-text {
  font-size: 28rpx;
  color: #2C2C2C;
  line-height: 2;
  display: block;
}

.quote-text {
  color: #C41E3A;
  font-style: italic;
}

/* 实验步骤 */
.experiment-step {
  display: flex;
  flex-direction: column;
}

.canvas-container {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.physics-canvas {
  width: 100%;
  height: 100%;
}

/* 统计面板 */
.stats-panel {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #8B9DAF;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.stat-up {
  color: #4FC3F7;
}

.stat-down {
  color: #C41E3A;
}

/* 控制按钮 */
.controls {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.ctrl-btn {
  padding: 16rpx 48rpx;
  background: rgba(196, 30, 58, 0.85);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.3);
}

.ctrl-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.ctrl-btn:active {
  transform: scale(0.96);
  transition: transform 0.2s ease;
}

.ctrl-stop {
  background: rgba(139, 157, 175, 0.85);
  box-shadow: 0 4rpx 16rpx rgba(139, 157, 175, 0.3);
}

/* 结果面板 */
.result-panel {
  margin-top: 16rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #C41E3A;
  display: block;
  margin-bottom: 12rpx;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  display: block;
}

/* 步骤导航 */
.step-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-placeholder {
  width: 120rpx;
}

.nav-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(139, 157, 175, 0.3);
  border-radius: 20rpx;
}

.nav-btn text {
  font-size: 28rpx;
  color: #C41E3A;
}

.nav-btn:active {
  transform: scale(0.96);
  transition: transform 0.2s ease;
}

.nav-next {
  background: rgba(196, 30, 58, 0.1);
  border-color: rgba(196, 30, 58, 0.3);
}
