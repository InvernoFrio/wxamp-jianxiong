<view class="physics-page page-enter diffusion-page">

  <!-- step indicator -->
  <view class="step-indicator">
    <view wx:for="{{steps}}" wx:key="index"
      class="step-dot {{currentStep >= index ? 'active' : ''}}">
    </view>
  </view>

  <!-- STEP 0 -->
  <view class="step-content" wx:if="{{currentStep === 0}}">
    <view class="step-hero">
      <text class="hero-icon">🌫️</text>
      <text class="hero-title">{{steps[0].title}}</text>
      <text class="hero-desc">{{steps[0].desc}}</text>
    </view>

    <glass-card>
      <text class="intro-text">气体扩散是统计物理的经典现象：大量分子在热运动驱动下，
        从高浓度区域向低浓度区域自发迁移，最终趋向均匀分布。
      </text>
    </glass-card>

    <glass-card>
      <text class="intro-text">单个分子的运动完全随机，无法预测
        但数以亿计的分子叠加在一起，却产生出规律性极强的
        宏观浓度梯度——这正是统计物理的魅力所在
      </text>
    </glass-card>
  </view>

  <!-- STEP 1 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="step-hero">
      <text class="hero-icon">📐</text>
      <text class="hero-title">{{steps[1].title}}</text>
      <text class="hero-desc">{{steps[1].desc}}</text>
    </view>

    <glass-card>
      <text class="intro-text">格雷厄姆定律（1848年）指出：
        在相同温度下，气体分子的扩散速率与其摩尔质量的平方根成反比。
      </text>
    </glass-card>

    <glass-card>
      <text class="intro-text">U-235 与 U-238 摩尔质量仅相差约 1.3%，
        导致 U-235 的扩散速率仅快约 0.4%。
        单级分离系数 α ≈ 1.0043，效果极其微弱。
      </text>
    </glass-card>

    <glass-card>
      <text class="intro-text">曼哈顿计划中，橡树岭工厂建造了数千级扩散级联装置，
        耗电量占当时美国全国用电量的约 1/6，
        才将 U-235 浓度从天然的 0.7% 提升至 90% 以上。
      </text>
    </glass-card>
  </view>

  <!-- STEP 2 实验 -->
  <view class="step-content experiment-step" wx:if="{{currentStep === 2}}">

    <!-- 步骤引导条 -->
    <view class="guide-bar">
      <text class="guide-text">{{guideText}}</text>
    </view>

    <!-- 信息按钮 -->
    <view class="info-btn-wrap">
      <view class="info-btn" bindtap="onShowInfo">ℹ</view>
    </view>

    <!-- canvas -->
    <view class="canvas-container diffusion-canvas">
      <canvas id="diffCanvas" type="2d" class="physics-canvas"></canvas>

      <!-- 图例 -->
      <view class="legend">
        <view class="legend-item">
          <view class="legend-dot legend-light"></view>
          <text class="legend-label">U-235（轻）</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-heavy"></view>
          <text class="legend-label">U-238（重）</text>
        </view>
      </view>
    </view>

    <!-- 丰度 + 分离系数面板 -->
    <view class="abundance-panel">
      <view class="abundance-main">
        <text class="abundance-label">当前 U-235 丰度</text>
        <text class="abundance-value">{{abundancePercent}}%</text>
        <view class="abundance-bar-bg">
          <view class="abundance-bar-fill" style="width: {{abundancePercent > 100 ? 100 : abundancePercent}}\%"></view>
        </view>
      </view>
      <view class="alpha-box">
        <text class="alpha-label">分离系数 α</text>
        <text class="alpha-value">{{separationFactor}}</text>
      </view>
    </view>

    <!-- 级联进度条 -->
    <view class="cascade-panel">
      <view class="cascade-header">
        <text class="cascade-title">级联进度</text>
        <text class="cascade-count">第 {{cascadeLevel}} 级 / 4000 级</text>
      </view>
      <view class="cascade-bar-bg">
        <view class="cascade-bar-fill" style="width: {{cascadeLevel / 40}}\%"></view>
      </view>
      <view class="cascade-labels">
        <text class="cascade-lbl">0.7%（天然）</text>
        <text class="cascade-lbl">3%（核电）</text>
        <text class="cascade-lbl">90%（武器级）</text>
      </view>
    </view>

    <!-- 粒子统计 -->
    <view class="stats-panel diffusion-stats">
      <view class="stat-item">
        <text class="stat-label">左 U-235</text>
        <text class="stat-value stat-up">{{leftLight}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">左 U-238</text>
        <text class="stat-value stat-down">{{leftHeavy}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">右 U-235</text>
        <text class="stat-value stat-up">{{rightLight}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">右 U-238</text>
        <text class="stat-value stat-down">{{rightHeavy}}</text>
      </view>
    </view>

    <!-- 控制按钮组 -->
    <view class="controls">
      <glass-button wx:if="{{!experimentRunning}}" bind:tap="onStartExperiment" class="ctrl-btn">
        ▶ 启动扩散
      </glass-button>
      <glass-button wx:if="{{experimentRunning}}" bind:tap="onStopExperiment" class="ctrl-btn">
        ■ 停止
      </glass-button>
      <glass-button bind:tap="onAddCascade" class="ctrl-btn ctrl-cascade">
        ＋ 增加一级
      </glass-button>
      <glass-button bind:tap="onSpeedUp" class="ctrl-btn ctrl-speed">
        ⚡ ×{{speedMultiplier}}
      </glass-button>
      <glass-button bind:tap="onResetExperiment" class="ctrl-btn ctrl-reset">
        ↻ 重置
      </glass-button>
    </view>

    <!-- 截图保存 -->
    <view class="save-row">
      <view class="save-btn" bindtap="onSaveScreenshot">📷 截图保存</view>
    </view>

    <!-- 结果面板 -->
    <view class="result-panel" wx:if="{{experimentDone}}">
      <glass-card>
        <text class="result-title">富集结果（右侧）</text>
        <view class="result-bar">
          <view class="result-bar-same" style="width: {{enrichmentPercent}}\%">
            <text class="bar-label">U-235 {{enrichmentPercent}}%</text>
          </view>
          <view class="result-bar-diff" style="width: {{100 - enrichmentPercent}}\%">
            <text class="bar-label">U-238 {{100 - enrichmentPercent}}%</text>
          </view>
        </view>
        <text class="result-desc">经过多轮扩散，较轻的 U-235 优先穿越隔膜小孔，
          在右侧腔室逐步富集。单级效果虽微弱，
          但级联叠加后浓度差异显著放大。
        </text>
      </glass-card>
    </view>

  </view>

  <!-- STEP 3 -->
  <view class="step-content" wx:if="{{currentStep === 3}}">
    <view class="step-hero">
      <text class="hero-icon">🏁</text>
      <text class="hero-title">{{steps[3].title}}</text>
      <text class="hero-desc">{{steps[3].desc}}</text>
    </view>

    <glass-card>
      <text class="intro-text">气体扩散法揭示了统计物理最核心的思想：
        微观层面极其微小的概率差异，经过大量粒子与多次循环的叠加，
        最终涌现为可测量的宏观效应。
      </text>
    </glass-card>

    <glass-card>
      <text class="intro-text">气体扩散法因能耗巨大，1980 年代后逐渐被离心分离法取代。
        离心机利用同位素在高速旋转中的质量差异实现分离，
        效率是扩散法的数十倍。
      </text>
    </glass-card>

    <glass-card>
      <text class="intro-text">今天，同位素分离技术广泛应用于核电燃料制备、
        医用放射性同位素生产，以及基础粒子物理研究，
        远超其最初的历史背景。
      </text>
    </glass-card>
  </view>

  <!-- 导航 -->
  <view class="step-nav">
    <view class="nav-btn" wx:if="{{currentStep > 0}}" bindtap="onPrevStep">
      <text>‹ 上一步</text>
    </view>
    <view class="nav-placeholder" wx:else></view>
    <view class="nav-btn nav-next" wx:if="{{currentStep < 3}}" bindtap="onNextStep">
      <text>下一步 ›</text>
    </view>
    <view class="nav-btn nav-next" wx:if="{{currentStep === 3}}" bindtap="onNextStep">
      <text>返回 ›</text>
    </view>
  </view>

  <!-- 原理弹窗 -->
  <view class="modal-mask" wx:if="{{showInfoModal}}" bindtap="onCloseInfo">
    <view class="modal-card" catchtap="">
      <text class="modal-title">扩散分离原理</text>
      <text class="modal-formula">r₁/r₂ = √(M₂/M₁)</text>
      <text class="modal-sub">格雷厄姆定律：速率之比等于摩尔质量之比的平方根</text>
      <view class="modal-divider"></view>
      <text class="modal-formula">α = √(352/349) ≈ 1.0043</text>
      <text class="modal-sub">U-235/U-238 单级分离系数极接近 1，需要约 4000 级级联才能达到武器级丰度（90%）。</text>
      <view class="modal-close" bindtap="onCloseInfo">✕ 关闭</view>
    </view>
  </view>

</view>

