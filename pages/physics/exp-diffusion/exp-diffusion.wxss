/* pages/physics/exp-diffusion/exp-diffusion.wxss */
/* =======================
   BASE LAYOUT（实验系统基底）
======================= */

.container {
  padding: 20rpx;
  min-height: 100vh;
  color: #fff;

  background:
    radial-gradient(circle at 85% 10%, rgba(56,189,248,0.18), transparent 42%),
    radial-gradient(circle at 15% 85%, rgba(34,197,94,0.14), transparent 45%),
    radial-gradient(circle at 50% 50%, rgba(148,163,184,0.05), transparent 60%),
    #0f172a;
}

/* =======================
   STEP SYSTEM（严格 parity风格）
======================= */

.step-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(148,163,184,0.25);
  transition: all 0.3s ease;
}

.step-dot.active {
  background: #38bdf8;
  transform: scale(1.4);
  box-shadow: 0 0 0 10rpx rgba(56,189,248,0.12);
}

/* =======================
   STEP CONTENT（实验叙事层）
======================= */

.step-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  animation: fadeIn 0.35s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.step-hero {
  text-align: center;
  padding: 30rpx 0;
}

.hero-icon {
  font-size: 68rpx;
  display: block;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* =======================
   GLASS CARD（统一实验卡片）
======================= */

.card {
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 22rpx;
  padding: 22rpx;

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  box-shadow: 0 10rpx 28rpx rgba(0,0,0,0.25);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: #38bdf8;
}

.card-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #cbd5f5;
}

/* =======================
   EXPERIMENT CORE AREA（canvas层）
======================= */

.canvas-container {
  width: 100%;
  height: 420rpx;
  border-radius: 26rpx;
  overflow: hidden;

  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.08);

  box-shadow: inset 0 0 40rpx rgba(0,0,0,0.35);
}

.physics-canvas {
  width: 100%;
  height: 100%;
}

/* =======================
   DETECTOR PANEL（stats升级）
======================= */

.stats-panel {
  display: flex;
  justify-content: space-between;
  padding: 22rpx;

  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.10);
  border-radius: 22rpx;

  backdrop-filter: blur(12px);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
}

.stat-up {
  color: #38bdf8;
}

.stat-down {
  color: #f87171;
}

/* =======================
   CONTROL PANEL（实验控制台）
======================= */

.controls {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

button {
  flex: 1;
  border-radius: 16rpx;
  font-size: 26rpx;
  transition: all 0.15s ease;
}

/* start */
button[type="primary"] {
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  color: #fff;
}

/* stop */
button:nth-child(2) {
  background: rgba(248,113,113,0.12);
  color: #f87171;
}

/* reset */
button:nth-child(3) {
  background: rgba(148,163,184,0.12);
  color: #cbd5f5;
}

button:active {
  transform: scale(0.96);
  opacity: 0.85;
}

/* =======================
   RESULT PANEL（物理结论层）
======================= */

.result-bar {
  display: flex;
  height: 36rpx;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
}

.result-bar-up {
  background: #38bdf8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-bar-down {
  background: #f87171;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-label {
  font-size: 20rpx;
  color: #fff;
}

/* =======================
   NAVIGATION（parity一致）
======================= */

.step-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.nav-btn {
  padding: 14rpx 28rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.10);
  border-radius: 16rpx;
  color: #cbd5f5;
}

.nav-btn:active {
  transform: scale(0.95);
  background: rgba(56,189,248,0.08);
}