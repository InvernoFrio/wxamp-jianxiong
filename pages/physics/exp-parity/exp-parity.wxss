.physics-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 92% -2%, rgba(196, 30, 58, 0.13), transparent 30%),
    radial-gradient(circle at 6% 96%, rgba(79, 195, 247, 0.16), transparent 34%),
    linear-gradient(180deg, #f8f3eb 0%, #f5f0e8 55%, #efe6da 100%);
  padding: 20rpx 24rpx;
  padding-bottom: 120rpx;
}

/* 顶部控制栏 */
.top-control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(12rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.control-group {
  display: flex;
  gap: 12rpx;
}

.info-btn,
.reset-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(196, 30, 58, 0.12);
  border: 1rpx solid rgba(196, 30, 58, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.info-btn:active,
.reset-btn:active {
  transform: scale(0.9);
  background: rgba(196, 30, 58, 0.2);
}

.mirror-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toggle-label {
  font-size: 24rpx;
  color: #2C2C2C;
  font-weight: 500;
}

.switch {
  width: 52rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #D0D0D0;
  position: relative;
  transition: background 0.3s ease;
}

.switch::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: white;
  top: 2rpx;
  left: 2rpx;
  transition: left 0.3s ease;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.switch.active {
  background: #C41E3A;
}

.switch.active::after {
  left: 26rpx;
}

/* 公式弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.modal-overlay.show {
  background: rgba(0, 0, 0, 0.4);
  opacity: 1;
  pointer-events: auto;
}

.formula-modal {
  background: white;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  max-width: 90%;
  max-height: 80vh;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  position: relative;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8B9DAF;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #C41E3A;
  margin-bottom: 24rpx;
  text-align: center;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.formula-content {
  background: rgba(79, 195, 247, 0.08);
  border-left: 4rpx solid #4FC3F7;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.formula-equation {
  display: block;
  font-size: 32rpx;
  font-family: 'Courier New', monospace;
  color: #0288D1;
  text-align: center;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.formula-desc {
  display: block;
  font-size: 26rpx;
  color: #2C2C2C;
  text-align: center;
}

.parity-info {
  background: rgba(196, 30, 58, 0.08);
  border-left: 4rpx solid #C41E3A;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.parity-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #C41E3A;
  margin-bottom: 8rpx;
}

.parity-explain {
  display: block;
  font-size: 26rpx;
  color: #2C2C2C;
  line-height: 1.6;
}

.formula-hint {
  display: block;
  font-size: 24rpx;
  color: #8B9DAF;
  text-align: center;
  font-style: italic;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(139, 157, 175, 0.28);
  transition: all 0.3s ease;
}

.step-dot.active {
  background: #C41E3A;
  transform: scale(1.34);
  box-shadow: 0 0 0 10rpx rgba(196, 30, 58, 0.12);
  animation: dotPulse 2s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 10rpx rgba(196, 30, 58, 0.12); }
  50% { box-shadow: 0 0 0 16rpx rgba(196, 30, 58, 0.06); }
}

/* 步骤内容 */
.step-content {
  animation: fadeInUp 0.4s ease-out;
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}

.step-content glass-card {
  padding: 28rpx;
}

.step-hero {
  animation: heroAppear 0.5s ease-out;
}

@keyframes heroAppear {
  from { opacity: 0; transform: translateY(16rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.step-hero {
  text-align: center;
  padding: 30rpx 0 44rpx;
}

.hero-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.hero-desc {
  font-size: 26rpx;
  color: #8B9DAF;
}

.intro-text {
  font-size: 28rpx;
  color: #2C2C2C;
  line-height: 2.08;
  display: block;
}

.quote-text {
  color: #C41E3A;
  font-style: italic;
  text-align: center;
  padding: 8rpx 16rpx;
}

.quote-card {
  border-color: rgba(196, 30, 58, 0.2);
  background: rgba(196, 30, 58, 0.04);
}

/* 引导提示 */
.guide-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(79, 195, 247, 0.1);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #4FC3F7;
}

.tip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #2C2C2C;
  line-height: 1.6;
}

.experiment-guide {
  background: rgba(196, 30, 58, 0.08);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(196, 30, 58, 0.2);
}

.guide-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #C41E3A;
  margin-bottom: 12rpx;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guide-steps text {
  font-size: 24rpx;
  color: #2C2C2C;
}

/* 温度控制 */
.temperature-control {
  background: rgba(255, 255, 255, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.temp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.temp-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.temp-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #C41E3A;
  font-family: 'Courier New', monospace;
}

.temp-slider-container {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.temp-text {
  font-size: 20rpx;
  color: #8B9DAF;
  min-width: 50rpx;
  text-align: center;
}

.temp-slider {
  flex: 1;
}

.slider {
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #E53935 0%, #FFB74D 50%, #4FC3F7 100%);
  border-radius: 2rpx;
}

.temp-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8B9DAF;
}

.hint-icon {
  font-size: 28rpx;
}

.hint-text {
  font-weight: 500;
}

/* 显示容器 */
.display-container {
  margin-bottom: 20rpx;
}

.display-container.normal-mode {
  display: flex;
  justify-content: center;
}

.display-container.split-mode {
  display: flex;
  gap: 12rpx;
}

.canvas-wrapper {
  display: flex;
  flex-direction: column;
}

.canvas-wrapper.half-width {
  flex: 1;
}

.canvas-wrapper.hide {
  display: none;
}

.world-label {
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #2C2C2C;
  margin-bottom: 8rpx;
}

.world-label.hide {
  display: none;
}

/* 实验步骤 */
.experiment-step {
  display: flex;
  flex-direction: column;
}

.canvas-container {
  width: 100%;
  height: 430rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  box-shadow: 0 12rpx 30rpx rgba(37, 28, 22, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
}

.display-container.split-mode .canvas-container {
  height: 340rpx;
}

.physics-canvas {
  width: 100%;
  height: 100%;
}

.canvas-label {
  text-align: center;
  font-size: 22rpx;
  color: #8B9DAF;
  margin-bottom: 8rpx;
}

/* 统计面板 */
.stats-panel {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 26rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #8B9DAF;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.stat-up {
  color: #4FC3F7;
}

.stat-down {
  color: #C41E3A;
}

/* 控制按钮 */
.controls {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* 结果面板 */
.result-panel {
  margin-top: 16rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #C41E3A;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.share-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(196, 30, 58, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.share-btn:active {
  transform: scale(0.9);
  background: rgba(196, 30, 58, 0.3);
}

.result-bar {
  display: flex;
  height: 48rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.result-bar-up {
  background: linear-gradient(90deg, #4FC3F7, #29B6F6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.6s ease;
}

.result-bar-down {
  background: linear-gradient(90deg, #E53935, #C41E3A);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 0.6s ease;
}

.bar-label {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}

.result-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  display: block;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.result-conclusion {
  display: block;
  font-size: 26rpx;
  color: #2C2C2C;
  font-weight: 500;
  padding: 12rpx;
  background: rgba(196, 30, 58, 0.08);
  border-radius: 8rpx;
  border-left: 4rpx solid #C41E3A;
}

/* 结论框 */
.conclusion-box {
  background: rgba(255, 255, 255, 0.5);
  border: 2rpx solid rgba(196, 30, 58, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.conclusion-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #C41E3A;
  margin-bottom: 12rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.conclusion-text {
  display: block;
  font-size: 26rpx;
  color: #2C2C2C;
  line-height: 1.8;
}

/* 步骤导航 */
.step-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-placeholder {
  width: 120rpx;
}

.nav-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(139, 157, 175, 0.24);
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.nav-btn text {
  font-size: 28rpx;
  color: #C41E3A;
}

.nav-btn:active {
  transform: scale(0.95);
  background: rgba(196, 30, 58, 0.1);
}

.nav-next {
  background: rgba(196, 30, 58, 0.1);
  border-color: rgba(196, 30, 58, 0.3);
}
