/* pages/grid-walking/grid-walking.wxss */
.page-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 80% 10%, rgba(212, 165, 116, 0.1), transparent 40%),
    linear-gradient(180deg, #f5eed8 0%, #efe7da 50%, #f8f6f2 100%);
  display: flex;
  flex-direction: column;
}

/* 地图区域 */
.map-area {
  width: 100%;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  position: relative;
}

.map-wrapper {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(100, 80, 50, 0.12);
  border: 2rpx solid rgba(212, 165, 116, 0.3);
}

.route-tag {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.route-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.route-name {
  font-size: 24rpx;
  color: #54606B;
}

/* 信息面板 */
.info-panel {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 36rpx 48rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.panel-handle {
  width: 64rpx;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

/* 节点信息 */
.node-info {
  margin-bottom: 28rpx;
}

.node-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.node-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 240, 232, 0.8);
  border-radius: 16rpx;
}

.node-title-area {
  display: flex;
  flex-direction: column;
}

.node-title {
  font-size: 36rpx;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.node-type-label {
  font-size: 24rpx;
  font-weight: 500;
}

.node-desc {
  font-size: 28rpx;
  color: #54606B;
  line-height: 1.7;
  padding-left: 84rpx;
}

/* 进度条 */
.progress-bar {
  margin-bottom: 28rpx;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4A574, #C41E3A);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #8B9DAF;
}

/* 操作按钮区 */
.action-area {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  padding: 28rpx 40rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease;
}

.action-btn:active {
  transform: scale(0.97);
}

.primary-btn {
  background: linear-gradient(135deg, #C41E3A, #A62121);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(166, 33, 33, 0.25);
}

.end-btn {
  background: linear-gradient(135deg, #D4A574, #C49A6C);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.3);
}

.reachable-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 16rpx;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #8B9DAF;
}

/* 摘要弹窗 */
.summary-overlay,
.route-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}

.summary-card,
.route-card {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 48rpx 40rpx;
  background: rgba(255, 255, 255, 0.95) !important;
}

.summary-title,
.route-card-title {
  font-size: 40rpx;
  color: #1A1A1A;
  text-align: center;
  display: block;
}

.summary-divider,
.route-divider {
  width: 80rpx;
  height: 4rpx;
  background: #C41E3A;
  margin: 24rpx auto 36rpx;
  border-radius: 2rpx;
}

.summary-section {
  margin-bottom: 32rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #8B9DAF;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.summary-nodes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.summary-node-item {
  font-size: 26rpx;
  color: #54606B;
  line-height: 1.6;
}

.summary-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.summary-progress-track {
  flex: 1;
  height: 12rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 6rpx;
  overflow: hidden;
}

.summary-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4A574, #C41E3A);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.summary-progress-text {
  font-size: 24rpx;
  color: #8B9DAF;
  white-space: nowrap;
}

.completed-routes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.completed-route-tag {
  padding: 8rpx 20rpx;
  border: 2rpx solid;
  border-radius: 100rpx;
  font-size: 24rpx;
}

.summary-actions {
  margin-top: 40rpx;
}

/* 路线选择 */
.route-option {
  padding: 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}

.route-option:active {
  transform: scale(0.98);
}

.route-completed {
  opacity: 0.5;
}

.route-option-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.route-option-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.route-option-name {
  font-size: 32rpx;
  color: #1A1A1A;
  flex: 1;
}

.route-option-check {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
}

.route-option-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  padding-left: 36rpx;
  display: block;
}

/* === 内容内嵌弹窗 === */
.content-modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 200;
}

.content-modal-card {
  width: 100%;
  max-height: 85vh;
  background: linear-gradient(180deg, #faf6ef, #f0e8d8);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 40rpx 16rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}

.content-modal-title {
  font-size: 36rpx;
  color: #1A1A1A;
}

.content-modal-close {
  font-size: 40rpx;
  color: #8B9DAF;
  padding: 8rpx;
}

.content-modal-body {
  flex: 1;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 24rpx 34rpx 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.content-section-title {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 16rpx 0 8rpx;
  margin-top: 16rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  overflow: hidden;
}

.content-section-title text {
  font-size: 30rpx;
  color: #C41E3A;
  font-weight: 600;
  word-break: break-word;
  overflow-wrap: break-word;
}

.content-paragraph {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  text-indent: 2em;
}

.content-paragraph-text {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #3A3A3A;
  line-height: 2;
  white-space: normal;
  text-align: justify;
  text-justify: inter-ideograph;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.content-timeline-item {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  overflow: hidden;
}

.content-tl-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.content-tl-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.content-tl-year {
  font-size: 24rpx;
  color: #C41E3A;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.content-tl-title {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-tl-detail {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.content-tl-detail-text {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #54606B;
  line-height: 1.8;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.content-modal-footer {
  padding: 24rpx 0 48rpx;
  display: flex;
  justify-content: center;
}

.content-close-btn {
  padding: 20rpx 48rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 100rpx;
}

.content-close-btn text {
  font-size: 26rpx;
  color: #54606B;
}
