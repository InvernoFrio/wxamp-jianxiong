/* pages/comic/comic.wxss */
.sub-page-container {
  min-height: 100vh;
  background: #F8F6F2;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 60rpx;
  text-align: center;
}

.page-title {
  font-size: 48rpx;
  color: #1B1C1A;
}

.title-accent {
  width: 40rpx;
  height: 4rpx;
  background: #84010D;
  margin: 16rpx auto;
}

.comic-group {
  margin-bottom: 60rpx;
  padding: 30rpx;
  overflow: hidden;
}

.group-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.group-index {
  font-size: 20rpx;
  color: #84010D;
  font-weight: bold;
}

.group-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1B1C1A;
}

.comic-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.comic-item {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: #eee;
}

/* 如果只有三张图，让第一张占满整行 */
.comic-grid .comic-item:first-child:nth-last-child(3) {
  grid-column: span 2;
  height: 400rpx;
}

.group-date {
  display: block;
  font-size: 20rpx;
  color: #8D706D;
  margin-top: 30rpx;
  text-align: right;
  font-style: italic;
}
