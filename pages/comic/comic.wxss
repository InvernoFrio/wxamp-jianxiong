/* --- 全局配置 --- */
page {
  background-color: #F8F6F2;
  color: #261817;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.page-container {
  height: 100vh;
}

.main-content {
  max-width: 100%;
  padding: 40rpx; /* margin-screen */
  box-sizing: border-box;
}

/* --- 漫画条目布局 --- */
.comic-article {
  display: flex;
  flex-direction: column;
  margin-bottom: 80rpx; /* gap-default */
}

/* 章节头部 */
.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.section-index {
  color: #84010D;
}

.entry-title {
  margin-top: 4rpx;
  color: #261817;
}

.red-accent-bar {
  width: 80rpx;
  height: 6rpx;
  background-color: #84010D;
  margin-top: 16rpx;
}

.header-right {
  text-align: right;
  display: flex;
  flex-direction: column;
}

/* --- 图片网格 (Grid) --- */
.grid-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.image-wrapper {
  overflow: hidden;
  border-radius: 24rpx;
  background-color: #E8E4DE;
  border: 1px solid #E8E4DE;
  position: relative;
}

.col-span-2 {
  grid-column: span 2;
}

.comic-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 比例控制 */
.aspect-16-9 {
  aspect-ratio: 16 / 9;
}

.aspect-square {
  aspect-ratio: 1 / 1;
}

/* 触感反馈 */
.image-tactile {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.image-tactile:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* --- 字体排版 (Typography) --- */
/* 1. 大标题 - 强烈的衬线感 */
.font-headline-lg { 
  /* 优先使用 iOS/Android 系统衬线体 */
  font-family: "Georgia", "Times New Roman", serif; 
  font-weight: 600; 
}
.text-headline-lg { 
  font-size: 52rpx; 
  line-height: 1.3; 
}

/* 2. 中标题 - 优雅的叙事感 */
.font-headline-md { 
  font-family: "Georgia", "Times New Roman", serif; 
  font-weight: 500; 
}
.text-headline-md { 
  font-size: 40rpx; 
  line-height: 1.4; 
}

/* 3. 标签/作者名 - 也可以使用衬线体增加精致度 */
.font-label-md { 
  font-family: "Georgia", serif; 
  font-weight: 500; 
}
.text-label-md { 
  font-size: 26rpx; 
  letter-spacing: 0.05em; 
}

/* 4. 说明文字 - 建议保持系统默认或轻微衬线，确保小字清晰 */
.font-caption { 
  font-family: "Georgia", serif; 
  font-weight: 400; 
}
.text-caption { 
  font-size: 22rpx; 
  opacity: 0.7; 
}

/* 辅助颜色类 */
.text-outline { 
  color: #8D706D; 
}