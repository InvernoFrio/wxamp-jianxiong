<!--pages/timeline/timeline.wxml-->
<view class="page-container paper-bg">
  <view class="page-header fade-slide-up">
    <text class="page-title title-text">生平年表</text>
    <text class="page-subtitle">1912 — 1997</text>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-bar">
    <view 
      class="filter-tag {{activeFilter === item.key ? 'active' : ''}}" 
      wx:for="{{filters}}" 
      wx:key="key"
      bindtap="onFilterTap"
      data-key="{{item.key}}"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 时间轴 -->
  <scroll-view 
    class="timeline-scroll" 
    scroll-y 
    enhanced 
    show-scrollbar="{{false}}"
  >
    <view class="timeline-container">
      <timeline-item
        wx:for="{{filteredTimeline}}"
        wx:key="year"
        year="{{item.year}}"
        title="{{item.title}}"
        detail="{{item.detail}}"
        category="{{item.type}}"
        hasDetail="{{item.detail.length > 0}}"
        bind:toggle="onItemToggle"
        data-index="{{index}}"
      />
      
      <view class="timeline-end" wx:if="{{filteredTimeline.length === 0}}">
        <text class="end-text">暂无此类事件</text>
      </view>
    </view>
  </scroll-view>
</view>
