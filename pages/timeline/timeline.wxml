<view class="timeline-page page-enter">
  <!-- 筛选标签 -->
  <scroll-view class="filter-bar" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view
      wx:for="{{filterTabs}}"
      wx:key="key"
      class="filter-tab {{activeFilter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >
      <text>{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 时间轴列表 -->
  <view class="timeline-list">
    <view class="tl-axis">
      <view
        wx:for="{{filteredItems}}"
        wx:key="year"
        class="tl-wrapper"
        style="animation-delay: {{index * 0.05}}s;"
      >
        <timeline-item
          item="{{item}}"
          index="{{index}}"
          expanded="{{expandedIndex === index}}"
          last="{{index === filteredItems.length - 1}}"
          bind:toggle="onItemToggle"
        />
      </view>
    </view>
    <view class="empty-tip" wx:if="{{filteredItems.length === 0}}">
      <text>暂无数据</text>
    </view>
  </view>
</view>
