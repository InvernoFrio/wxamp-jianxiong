.timeline-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 90% 2%, rgba(212, 165, 116, 0.15), transparent 34%),
    linear-gradient(180deg, #f7f3ea 0%, #f5f0e8 46%, #efe8dc 100%);
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  padding: 20rpx 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: linear-gradient(180deg, rgba(247, 243, 234, 0.95) 0%, rgba(245, 240, 232, 0.88) 100%);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.filter-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx solid rgba(139, 157, 175, 0.22);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #8B9DAF;
  transition: all 0.26s ease;
}

.filter-tab.active {
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.2) 0%, rgba(196, 30, 58, 0.12) 100%);
  border-color: #C41E3A;
  color: #C41E3A;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(196, 30, 58, 0.16);
}

.filter-tab:active {
  transform: scale(0.96) translateY(2rpx);
}

/* 时间轴列表 */
.timeline-list {
  padding: 18rpx 0;
}

.tl-wrapper {
  opacity: 0;
  animation: fadeSlideIn 0.42s ease-out forwards;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-tip {
  text-align: center;
  padding: 96rpx 0;
}

.empty-tip text {
  font-size: 28rpx;
  color: #8B9DAF;
}
