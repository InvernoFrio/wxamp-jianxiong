.timeline-page {
  min-height: 100vh;
  background: #F5F0E8;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #F5F0E8;
}

.filter-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.4);
  border: 1rpx solid rgba(139, 157, 175, 0.3);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #8B9DAF;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: rgba(196, 30, 58, 0.12);
  border-color: #C41E3A;
  color: #C41E3A;
  font-weight: 500;
}

.filter-tab:active {
  transform: scale(0.96);
}

/* 时间轴列表 */
.timeline-list {
  padding: 20rpx 0;
}

.tl-wrapper {
  opacity: 0;
  animation: fadeSlideIn 0.4s ease-out forwards;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
}

.empty-tip text {
  font-size: 28rpx;
  color: #8B9DAF;
}
