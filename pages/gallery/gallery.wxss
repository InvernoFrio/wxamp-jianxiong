/* pages/gallery/gallery.wxss */
.sub-page-container {
  min-height: 100vh;
  background: #F8F6F2;
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}

.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.gallery-card {
  width: calc(50% - 10rpx);
  height: 480rpx;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-info-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.4));
}

.gallery-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
}

.title-accent {
  width: 40rpx;
  height: 4rpx;
  background: #84010D;
  margin: 16rpx auto;
}

.page-header {
  margin-bottom: 60rpx;
  text-align: center;
}

.group-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1B1C1A;
}