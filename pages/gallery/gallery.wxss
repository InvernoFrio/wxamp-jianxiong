/* pages/gallery/gallery.wxss */
/* 全局背景与容器 */
.sub-page-container {
  min-height: 100vh;
  background: #F8F6F2;
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}

/* 标题样式 */
.page-header {
  margin-bottom: 60rpx;
  text-align: center;
}

.serif-title {
  font-family: "Source Han Serif CN", "Songti SC", serif;
  font-size: 44rpx;
  color: #2c3e50;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.title-accent {
  width: 40rpx;
  height: 4rpx;
  background: #84010D;
  margin: 20rpx auto;
}

/* 网格布局：使用 Flex 确保间距均匀 */
.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.gallery-card {
  width: 340rpx; /* 适配大多数屏幕，留出间隙 */
  height: 480rpx;
  margin-bottom: 22rpx;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08);
  background: #fff; /* 图片加载前的底色 */
  transition: transform 0.3s ease;
}

/* 点击缩放反馈 */
.active-scale:active {
  transform: scale(0.97);
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 渐变遮罩文字 */
.gallery-info-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 20rpx 15rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
}

.gallery-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

/* 加载状态区样式 */
.load-status {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.loading-icon {
  animation: fadeIn 1s infinite alternate;
}

.finished-text {
  opacity: 0.6;
  letter-spacing: 2rpx;
}

/* 空状态样式 */
.empty-box {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

@keyframes fadeIn {
  from { opacity: 0.5; }
  to { opacity: 1; }
}