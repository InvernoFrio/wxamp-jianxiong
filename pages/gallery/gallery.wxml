<!-- pages/gallery/gallery.wxml -->
<scroll-view class="sub-page-container" scroll-y="true">
  <view class="page-header">
    <text class="page-title serif-title">岁时光影</text>
    <view class="title-accent"></view>
  </view>

  <view class="gallery-grid">
    <!-- wx:key 使用数据库自带的 _id -->
    <view 
      class="gallery-card active-scale" 
      wx:for="{{photos}}" 
      wx:key="_id" 
      bindtap="previewPhoto" 
      data-url="{{item.image}}"
    >
      <!-- src 直接引用数据库中的 image 字段 (cloud://...) -->
      <image 
        class="gallery-img" 
        src="{{item.image}}" 
        mode="aspectFill" 
        lazy-load="true"
      ></image>
      <view class="gallery-info-overlay">
        <text class="gallery-text">{{item.title}}</text>
      </view>
    </view>
  </view>
</scroll-view>