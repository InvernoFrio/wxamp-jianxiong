<!-- pages/gallery/gallery.wxml -->
<!-- 页面容器 -->
<view class="sub-page-container">
  
  <!-- 顶部标题区 -->
  <view class="page-header">
    <text class="page-title serif-title">岁时光影</text>
    <view class="title-accent"></view>
  </view>

  <!-- 图片网格 -->
  <view class="gallery-grid">
    <view 
      class="gallery-card active-scale" 
      wx:for="{{photos}}" 
      wx:key="_id" 
      bindtap="previewPhoto" 
      data-url="{{item.image}}"
    >
      <image 
        class="gallery-img" 
        src="{{item.image}}" 
        mode="aspectFill" 
        lazy-load="true"
      ></image>
      <view class="gallery-info-overlay">
        <text class="gallery-text">{{item.author || '匿名人士'}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态提示 -->
  <view class="load-status">
    <block wx:if="{{photos.length > 0}}">
      <view class="loading-icon" wx:if="{{!isFinished}}">正在加载美好...</view>
      <view class="finished-text" wx:else>—— 故事到此，未完待续 ——</view>
    </block>
    
    <!-- 空状态 -->
    <view class="empty-box" wx:if="{{photos.length === 0 && !loading}}">
      <image src="/images/empty.png" mode="aspectFit" class="empty-img"></image>
      <text>相册还没有照片</text>
    </view>
  </view>
</view>