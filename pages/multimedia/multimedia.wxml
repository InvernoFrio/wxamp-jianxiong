<!-- pages/multimedia/multimedia.wxml -->
<scroll-view class="media-container" scroll-y="true">
  
  <!-- 英雄标题区域 -->
  <section class="hero-section">
    <view class="title-row">
      <text class="main-title serif-title">影音流年</text>
      <text class="en-label">MULTIMEDIA</text>
    </view>
    <view class="title-line"></view>
    <text class="hero-desc">收集岁月里的色彩、光影与回响。每一份记录都是时间的注脚。</text>
  </section>

  <!-- 漫画模块预览 -->
  <section>
    <view class="section-header">
      <view class="header-indicator"></view>
      <text class="section-title serif-title">叙事漫画</text>
      <navigator url="/pages/comic/comic" class="more-link">全集回顾</navigator>
    </view>
    <view class="glass comic-preview-card active-scale" bindtap="goToComic">
      <!-- 自动展示最新漫画组的前三张图 -->
      <image class="comic-img-mini" src="{{comicPreview.images[0]}}" mode="aspectFill"></image>
      <image class="comic-img-mini" src="{{comicPreview.images[1]}}" mode="aspectFill"></image>
      <image class="comic-img-mini" src="{{comicPreview.images[2]}}" mode="aspectFill"></image>
      <view class="comic-img-mini flex-center" style="background:#F5F5F5; display:flex; align-items:center; justify-content:center;">
        <text style="font-size:24rpx; color:#8D706D;">+ {{comicPreview.title}}</text>
      </view>
    </view>
  </section>

  <!-- 图片模块预览 -->
  <section>
    <view class="section-header">
      <view class="header-indicator"></view>
      <text class="section-title serif-title">岁时光影</text>
      <navigator url="/pages/gallery/gallery" class="more-link">进入画廊</navigator>
    </view>
    <scroll-view class="gallery-scroll" scroll-x="true">
      <view class="gallery-item active-scale" wx:for="{{galleryList}}" wx:key="_id" bindtap="goToGallery">
        <view class="photo-wrapper">
          <!-- 注意：gallery 集合中的字段名为 image -->
          <image class="photo-img" src="{{item.image}}" mode="aspectFill"></image>
        </view>
        <text class="photo-title">{{item.title}}</text>
        <text class="photo-desc">{{item.author}}</text>
      </view>
    </scroll-view>
  </section>

  <!-- 视频模块预览 -->
  <section>
    <view class="section-header">
      <view class="header-indicator"></view>
      <text class="section-title serif-title">影像记录</text>
      <navigator url="/pages/video/video" class="more-link">查看更多</navigator>
    </view>
    <view class="video-card active-scale" bindtap="goToVideo">
      <!-- 使用云端视频的封面图 -->
      <image class="video-thumb" src="{{videoPreview.poster}}" mode="aspectFill"></image>
      <view class="video-overlay">
        <view class="play-btn">
          <view class="play-icon"></view>
        </view>
      </view>
      <view class="video-info">
        <text class="time-label">最新推荐 | {{videoPreview.title}}</text>
        <view class="progress-bar">
          <view class="progress-inner" style="width: 45%;"></view>
        </view>
      </view>
    </view>
  </section>

  <!-- 音乐控制台 -->
  <section>
    <view class="section-header">
      <view class="header-indicator"></view>
      <text class="section-title serif-title">拾音</text>
      <text class="section-subtitle">Acoustic Memory</text>
    </view>
    <view class="glass music-console">
      <view class="vinyl-wrapper">
        <view class="vinyl-record {{isPlaying ? 'spinning' : ''}}">
          <!-- 封面图也从云端获取 -->
          <image class="record-cover" src="{{musicItem.cover}}" mode="aspectFill"></image>
        </view>
      </view>
      <view class="music-info">
        <text class="music-name">{{musicItem.title}}</text>
        <text class="music-author">{{musicItem.author}}</text>
        <view class="music-controls">

          <text class="ctrl-icon" bindtap="restartMusic">↺</text>
          <view class="play-pause-btn active-scale" bindtap="togglePlay">
            <text class="ctrl-icon-main">{{isPlaying ? '⏸' : '▶'}}</text>
          </view>
          <text class="ctrl-icon">⏭</text>
        </view>
      </view>
    </view>
  </section>

</scroll-view>