<!-- pages/video/video.wxml -->
<scroll-view class="sub-page-container" scroll-y="true">
  <view class="page-header">
    <text class="page-title serif-title">影像记录</text>
    <view class="title-accent"></view>
  </view>

  <view class="video-list">
    <!-- 使用云数据库的 _id 作为 key -->
    <view class="video-item-wrapper" wx:for="{{videoList}}" wx:key="id">
      <video 
        class="video-player" 
        src="{{item.url}}" 
        poster="{{item.poster}}" 
        object-fit="cover"
        title="{{item.title}}"
        enable-play-gesture
        bindplay="onVideoPlay"
        id="video-{{item.id}}" 
        data-id="video-{{item.id}}"
        vnet-detete="true"
        controls
      ></video>
      <view class="video-meta">
        <view style="display: flex; justify-content: space-between; align-items: center;">
          <text class="video-title-text">{{item.title}}</text>
          <text style="font-size: 24rpx; color: #84010D;">作者: {{item.author}}</text>
        </view>
        <text class="video-desc-text">{{item.desc}}</text>
        <view class="video-footer">
          <text class="video-tag"># {{item.tag}}</text>
          <!-- 由于去掉了 date 字段，这里可以展示分类或留空 -->
        </view>
      </view>
    </view>
  </view>
</scroll-view>