/* pages/video/video.wxss */
.sub-page-container {
  min-height: 100vh;
  background: #F8F6F2;
  padding: 40rpx 0;
  box-sizing: border-box;
}

.title-accent {
  width: 40rpx;
  height: 4rpx;
  background: #84010D;
  margin: 16rpx auto;
  }

.page-header {
  margin-bottom: 60rpx;
  text-align: center;
  }

.video-list {
  display: flex;
  flex-direction: column;
  gap: 80rpx; /* 增加间距以展示完整电视造型 */
}

/* 电视机外壳包装 */
.video-item-wrapper {
  background: #D6D2CC; /* 电视外壳色 */
  padding: 30rpx 30rpx 40rpx 30rpx;
  margin: 0 32rpx;
  border-radius: 40rpx;
  border: 12rpx solid #B7B3AD;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.15);
}

/* 电视机屏幕区域 */
.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  box-shadow: inset 0 0 40rpx rgba(0,0,0,0.8);
  border: 4rpx solid #333;
}

.video-meta {
  padding: 30rpx 10rpx 0;
}

.video-title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1B1C1A;
  margin-bottom: 12rpx;
}

.video-desc-text {
  font-size: 26rpx;
  color: #59413E;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: block;
}

.video-footer {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid rgba(0,0,0,0.1);
  padding-top: 20rpx;
}

.video-tag {
  font-size: 22rpx;
  color: #84010D;
  background: rgba(132, 1, 13, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}