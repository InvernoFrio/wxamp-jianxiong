.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f1ea;
}

.disclaimer {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  padding: 12rpx 30rpx;
  background: rgba(255, 255, 255, 0.6);
}

.message-list {
  flex: 1;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-word;
}

.msg-user .bubble {
  background: #8b6f47;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-assistant .bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.loading-bubble {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.loading-dot {
  font-size: 50rpx;
  margin: 0 4rpx;
  animation: blink 1.4s infinite;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

.suggestions-title {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin: 30rpx 0 16rpx;
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 20rpx;
}

.suggestion-item {
  background: #fff;
  padding: 20rpx 28rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #8b6f47;
  border: 1rpx solid #e0d5c0;
  text-align: center;
}

.suggestion-item:active {
  background: #f5f1ea;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-box {
  flex: 1;
  height: 72rpx;
  background: #f5f1ea;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  background: #8b6f47;
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.send-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.suggestions-header {
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.change-suggestions {
  font-size: 26rpx;
  color: #9a7a4f;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(154, 122, 79, 0.35);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
}

.change-suggestions:active {
  opacity: 0.7;
}

.suggestion-list {
  width: 100%;
}

.followup-area {
  margin: 24rpx 32rpx 40rpx;
}

.followup-title {
  font-size: 26rpx;
  color: #a79b8a;
  margin-bottom: 16rpx;
  text-align: center;
}

.followup-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.followup-btn {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(154, 122, 79, 0.28);
  color: #8a6a42;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

.followup-btn:active {
  opacity: 0.75;
  transform: scale(0.99);
}