<view class="chat-container">
  <!-- 免责声明 -->
  <view class="disclaimer">
    内容由AI基于吴健雄先生公开史料生成，仅供学习参考
  </view>

  <!-- 消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y="true" 
    scroll-into-view="{{scrollTo}}"
    scroll-with-animation="true">
    
    <!-- 欢迎语 + 推荐问题（无对话时显示） -->
    <block wx:if="{{messages.length === 0}}">
      <view class="message msg-assistant">
        <view class="bubble">
          你好，我是吴健雄。很高兴能与你聊聊。你想问我什么呢？
        </view>
      </view>
      
      <!-- 推荐问题标题 + 换一批按钮 -->
      <view class="suggestions-header">
        <view class="suggestions-title">你可以这样问我：</view>
        <view class="change-suggestions" bindtap="refreshSuggestions">
          换一批
        </view>
      </view>

      <!-- 初始随机推荐问题 -->
      <view class="suggestions suggestion-list">
        <view 
          class="suggestion-item" 
          wx:for="{{suggestions}}" 
          wx:key="*this"
          bindtap="useSuggestion"
          data-text="{{item}}">
          {{item}}
        </view>
      </view>
    </block>

    <!-- 对话气泡 -->
    <view 
      wx:for="{{messages}}" 
      wx:key="index"
      id="msg-{{index}}"
      class="message {{item.role === 'user' ? 'msg-user' : 'msg-assistant'}}">
      <view class="bubble">{{item.content}}</view>
    </view>

    <!-- 加载提示 -->
    <view class="message msg-assistant" wx:if="{{loading}}">
      <view class="bubble loading-bubble">
        <text class="loading-dot">·</text>
        <text class="loading-dot">·</text>
        <text class="loading-dot">·</text>
      </view>
    </view>

    <!-- AI 回复后的后续话题按钮 -->
    <view
      wx:if="{{messages.length > 0 && followUpQuestions.length > 0 && !loading}}"
      class="followup-area"
    >
      <view class="followup-title">可以继续聊：</view>

      <view class="followup-list">
        <view
          wx:for="{{followUpQuestions}}"
          wx:key="*this"
          class="followup-btn"
          data-text="{{item}}"
          bindtap="useFollowUp"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view id="bottom-anchor" style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-area">
    <input 
      class="input-box"
      placeholder="向吴先生提问…"
      value="{{inputText}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="sendMessage"
      disabled="{{loading}}"/>
    <button 
      class="send-btn"
      bindtap="sendMessage"
      disabled="{{loading || !inputText}}">
      发送
    </button>
  </view>
</view>