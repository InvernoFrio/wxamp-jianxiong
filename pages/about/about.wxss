.about-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 2%, rgba(196, 30, 58, 0.12), transparent 30%),
    radial-gradient(circle at 10% 84%, rgba(212, 165, 116, 0.16), transparent 42%),
    linear-gradient(180deg, #f8f4ec 0%, #f5f0e8 45%, #eee5d8 100%);
  padding: 20rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 头部 */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 0 24rpx;
}

.about-logo {
  font-size: 88rpx;
  margin-bottom: 10rpx;
}

.about-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2C2C2C;
  letter-spacing: 9rpx;
  margin-bottom: 10rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.about-subtitle {
  font-size: 26rpx;
  color: #8B9DAF;
  margin-bottom: 10rpx;
}

.about-version {
  font-size: 22rpx;
  color: #D4A574;
  padding: 6rpx 16rpx;
  background: rgba(212, 165, 116, 0.16);
  border-radius: 14rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.24);
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #C41E3A;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.section-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 团队 */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.team-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.44);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(65, 49, 30, 0.09);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.team-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(65, 49, 30, 0.06);
}

.team-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #C41E3A, #D4A574);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  padding: 4rpx;
  box-shadow:
    0 8rpx 18rpx rgba(65, 49, 30, 0.12),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
  overflow: hidden;
}

.team-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background: #f5f0e8;
}

.team-info {
  flex: 1;
}

.team-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
}

.team-role {
  font-size: 24rpx;
  color: #C41E3A;
  display: block;
  margin-top: 4rpx;
}

.team-desc {
  font-size: 22rpx;
  color: #8B9DAF;
  display: block;
  margin-top: 4rpx;
}

/* 设计理念 */
.principle-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.principle-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 22rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(62, 47, 30, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.principle-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 10rpx rgba(62, 47, 30, 0.05);
}

.principle-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.principle-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
}

.principle-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  line-height: 1.8;
  display: block;
}

/* 底部 */
.about-footer {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.about-footer text {
  font-size: 22rpx;
  color: #8B9DAF;
}
