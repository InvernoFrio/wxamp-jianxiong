.about-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 2%, rgba(196, 30, 58, 0.12), transparent 30%),
    radial-gradient(circle at 10% 84%, rgba(212, 165, 116, 0.16), transparent 42%),
    linear-gradient(180deg, #f8f4ec 0%, #f5f0e8 45%, #eee5d8 100%);
  padding: 20rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 头部 */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 0 24rpx;
}

.about-logo {
  font-size: 88rpx;
  margin-bottom: 10rpx;
}

.about-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2C2C2C;
  letter-spacing: 9rpx;
  margin-bottom: 10rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.about-subtitle {
  font-size: 26rpx;
  color: #8B9DAF;
  margin-bottom: 10rpx;
}

.about-version {
  font-size: 22rpx;
  color: #D4A574;
  padding: 6rpx 16rpx;
  background: rgba(212, 165, 116, 0.16);
  border-radius: 14rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.24);
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #C41E3A;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.section-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 团队 */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.team-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.44);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(65, 49, 30, 0.09);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.team-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(65, 49, 30, 0.06);
}

.team-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #C41E3A, #D4A574);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  padding: 4rpx;
  box-shadow:
    0 8rpx 18rpx rgba(65, 49, 30, 0.12),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
  overflow: hidden;
}

.team-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background: #f5f0e8;
}

.team-info {
  flex: 1;
}

.team-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
}

.team-role {
  font-size: 24rpx;
  color: #C41E3A;
  display: block;
  margin-top: 4rpx;
}

.team-desc {
  font-size: 22rpx;
  color: #8B9DAF;
  display: block;
  margin-top: 4rpx;
}

/* 设计理念 */
.principle-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.principle-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 22rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(62, 47, 30, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.principle-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 10rpx rgba(62, 47, 30, 0.05);
}

.principle-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.principle-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
}

.principle-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  line-height: 1.8;
  display: block;
}

/* 底部 */
.about-footer {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.about-footer text {
  font-size: 22rpx;
  color: #8B9DAF;
}

/* 团队卡片按钮 */
.team-button {
  display: flex !important;
  align-items: center;
  padding: 24rpx !important;
  background: rgba(255, 255, 255, 0.44) !important;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68) !important;
  border-radius: 22rpx !important;
  box-shadow: 0 8rpx 20rpx rgba(65, 49, 30, 0.09);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  text-align: left !important;
  width: 100% !important;
  height: auto !important;
  line-height: 1 !important;
}

.team-button::after {
  display: none !important;
}

.team-button:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(65, 49, 30, 0.06);
}

/* 理念卡片按钮 */
.principle-button {
  padding: 24rpx !important;
  background: rgba(255, 255, 255, 0.45) !important;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68) !important;
  border-radius: 22rpx !important;
  text-align: center !important;
  box-shadow: 0 8rpx 20rpx rgba(62, 47, 30, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  height: auto !important;
  line-height: 1 !important;
}

.principle-button::after {
  display: none !important;
}

.principle-button:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 10rpx rgba(62, 47, 30, 0.05);
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  animation: fadeIn 0.2s ease;
}

/* 弹窗容器 */
.modal-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #f8f6f2;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(65, 49, 30, 0.3);
  z-index: 1000;
  max-width: 85vw;
  min-width: 70vw;
  max-height: 78vh;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.modal-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.modal-bg-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(24, 20, 16, 0.18), rgba(24, 20, 16, 0.72)),
    radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.32), transparent 45%);
}

.modal-with-bg .modal-header,
.modal-with-bg .modal-body,
.modal-with-bg .modal-footer {
  position: relative;
  z-index: 2;
}

.modal-with-bg .modal-title {
  color: #fffaf0;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.36);
}

.modal-with-bg .modal-close {
  color: rgba(255, 250, 240, 0.86);
}

.modal-with-bg .modal-text {
  color: #fffaf0;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.34);
}

.modal-with-bg .modal-header,
.modal-with-bg .modal-footer {
  border-color: rgba(255, 255, 255, 0.22);
}

.modal-with-bg .modal-button {
  background: rgba(255, 250, 240, 0.9);
  color: #A62121;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.16);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(196, 30, 58, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  flex: 1;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.modal-close {
  background: none;
  border: none;
  font-size: 32rpx;
  color: #8B9DAF;
  padding: 0;
  width: auto;
  height: auto;
  line-height: 1;
  padding-left: 16rpx;
}

.modal-close::after {
  display: none;
}

.modal-body {
  padding: 24rpx;
  min-height: 100rpx;
  max-height: 52vh;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  overflow-y: auto;
}

.modal-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
  text-align: left;
  white-space: pre-line;
  word-break: break-all;
}

.modal-footer {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  border-top: 1rpx solid rgba(196, 30, 58, 0.1);
}

.modal-button {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #C41E3A, #a01a2e);
  color: white;
  border: none;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.modal-button:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.3);
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translate(-50%, -40%);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%);
    opacity: 1;
  }
}
