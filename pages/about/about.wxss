.about-page {
  min-height: 100vh;
  background: #F5F0E8;
  padding: 20rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 头部 */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.about-logo {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.about-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2C2C2C;
  letter-spacing: 8rpx;
  margin-bottom: 8rpx;
}

.about-subtitle {
  font-size: 26rpx;
  color: #8B9DAF;
  margin-bottom: 8rpx;
}

.about-version {
  font-size: 22rpx;
  color: #D4A574;
  padding: 4rpx 16rpx;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 12rpx;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #C41E3A;
}

.section-text {
  font-size: 28rpx;
  color: #555;
  line-height: 2;
  display: block;
}

/* 团队 */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.team-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
}

.team-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C41E3A, #D4A574);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.team-avatar text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.team-info {
  flex: 1;
}

.team-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
}

.team-role {
  font-size: 24rpx;
  color: #C41E3A;
  display: block;
  margin-top: 4rpx;
}

.team-desc {
  font-size: 22rpx;
  color: #8B9DAF;
  display: block;
  margin-top: 4rpx;
}

/* 设计理念 */
.principle-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.principle-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  text-align: center;
}

.principle-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.principle-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
  margin-bottom: 8rpx;
}

.principle-desc {
  font-size: 26rpx;
  color: #8B9DAF;
  line-height: 1.8;
  display: block;
}

/* 底部 */
.about-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.about-footer text {
  font-size: 22rpx;
  color: #8B9DAF;
}
