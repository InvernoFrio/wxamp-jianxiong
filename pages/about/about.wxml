<view class="about-page page-enter">
  <!-- 头部 -->
  <view class="about-header">
    <text class="about-logo">⚛️</text>
    <text class="about-title">钴光拾遗</text>
    <text class="about-subtitle">吴健雄数字纪念馆</text>
    <text class="about-version">v1.0.0</text>
  </view>

  <!-- 项目介绍 -->
  <view class="section">
    <text class="section-title">项目介绍</text>
    <glass-card>
      <text class="section-text">「钴光拾遗」是一个致敬吴健雄先生的微信小程序，以钴-60实验为精神线索，通过数字化方式呈现她的生平事迹、科学成就和人格魅力。项目旨在让更多人了解这位伟大的物理学家，传承她的科学精神与爱国情怀。</text>
    </glass-card>
  </view>

  <!-- 团队成员 -->
  <view class="section">
    <text class="section-title">团队成员</text>
    <view class="team-list">
      <button
        wx:for="{{teams}}"
        wx:key="name"
        class="team-card glass team-button"
        data-section="团队成员"
        data-name="{{item.name}}"
        data-index="{{index}}"
        bindtap="showModal"
      >
        <view class="team-avatar">
          <image class="team-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
        </view>
        <view class="team-info">
          <text class="team-name">{{item.name}}</text>
          <text class="team-role">{{item.role}}</text>
          <text class="team-desc">{{item.desc}}</text>
        </view>
      </button>
    </view>
  </view>

  <!-- 设计理念 -->
  <view class="section">
    <text class="section-title">设计理念</text>
    <view class="principle-list">
      <button
        wx:for="{{principles}}"
        wx:key="title"
        class="principle-card glass principle-button"
        data-section="设计理念"
        data-title="{{item.title}}"
        data-index="{{index}}"
        bindtap="showModal"
      >
        <text class="principle-icon">{{item.icon}}</text>
        <text class="principle-title">{{item.title}}</text>
        <text class="principle-desc">{{item.desc}}</text>
      </button>
    </view>
  </view>

  <!-- 致谢 -->
  <view class="section">
    <text class="section-title">致谢</text>
    <glass-card>
      <text class="section-text">感谢张怀亮先生编著的《吴健雄传》为本项目提供了宝贵的传记资料。感谢南京大学、哥伦比亚大学等机构的历史文献与照片资料。感谢所有将吴健雄精神制作成可视化图像、视频、音乐的同学。</text>
      <text class="section-text" style="margin-top: 16rpx;">本项目仅用于学术与教育目的，向所有为科学事业做出贡献的前辈致敬。</text>
    </glass-card>
  </view>

  <!-- 底部 -->
  <view class="about-footer">
    <text>© 2026 钴光拾遗团队</text>
  </view>

  <!-- 弹窗 -->
  <view class="modal-overlay" wx:if="{{showModal}}" bindtap="closeModal"></view>
  <view class="modal-container {{modalBgUrl ? 'modal-with-bg' : ''}}" wx:if="{{showModal}}">
    <image wx:if="{{modalBgUrl}}" class="modal-bg-image" src="{{modalBgUrl}}" mode="aspectFill" />
    <view wx:if="{{modalBgUrl}}" class="modal-bg-mask"></view>
    <music-float
      wx:if="{{modalMusicEnabled}}"
      track="{{modalTrack}}"
      autoplay="{{true}}"
      stop-on-detach="{{true}}"
      compact="{{true}}"
    />
    <view class="modal-header">
      <text class="modal-title">{{modalTitle}}</text>
      <button class="modal-close" bindtap="closeModal">✕</button>
    </view>
    <view class="modal-body">
      <text class="modal-text" user-select="{{true}}">{{modalContent}}</text>
    </view>
    <view class="modal-footer">
      <button class="modal-button" bindtap="closeModal">关闭</button>
    </view>
  </view>
</view>
