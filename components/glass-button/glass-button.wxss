.glass-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  color: #2C2C2C;
  transition: all 0.3s ease;
}

.glass-btn:active {
  transform: scale(0.96);
}

.glass-btn.primary {
  background: rgba(196, 30, 58, 0.85);
  border-color: rgba(196, 30, 58, 0.6);
  color: #fff;
}

.glass-btn.ghost {
  background: transparent;
  border: 1rpx solid rgba(196, 30, 58, 0.5);
  color: #C41E3A;
}

.glass-btn.small {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.glass-btn.medium {
  padding: 16rpx 36rpx;
  font-size: 28rpx;
}

.glass-btn.large {
  padding: 20rpx 48rpx;
  font-size: 32rpx;
}

.glass-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}
