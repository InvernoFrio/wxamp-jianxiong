<view class="tl-item" bindtap="onTap">
  <view class="tl-left">
    <text class="tl-year">{{item.year}}</text>
    <view class="tl-dot" style="background: {{typeColor[item.type] || '#8B9DAF'}};"></view>
  </view>
  <view class="tl-card glass">
    <view class="tl-header">
      <text class="tl-icon">{{item.icon}}</text>
      <text class="tl-title">{{item.title}}</text>
    </view>
    <view class="tl-tag" style="background: {{typeColor[item.type] || '#8B9DAF'}};">
      <text>{{typeText[item.type] || '其他'}}</text>
    </view>
    <view class="tl-detail" wx:if="{{expanded}}">
      <text>{{item.detail}}</text>
    </view>
    <text class="tl-expand-hint">{{expanded ? '收起 ▲' : '展开详情 ▼'}}</text>
  </view>
</view>
