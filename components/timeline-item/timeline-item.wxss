.tl-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.tl-left {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-year {
  font-size: 24rpx;
  color: #C41E3A;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 2rpx rgba(0,0,0,0.1);
  z-index: 1;
}

.tl-line {
  width: 2rpx;
  flex: 1;
  background: rgba(139, 157, 175, 0.3);
  margin-top: 4rpx;
  min-height: 40rpx;
}

.tl-card {
  flex: 1;
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tl-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tl-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tl-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  flex: 1;
}

.tl-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.tl-tag text {
  font-size: 20rpx;
  color: #fff;
}

.tl-detail {
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  margin-top: 8rpx;
}

.tl-detail text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.9;
}

.tl-expand-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8B9DAF;
  margin-top: 8rpx;
}
