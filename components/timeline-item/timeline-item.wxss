.tl-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding-bottom: 26rpx;
}

.tl-left {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  align-self: stretch;
  flex-shrink: 0;
}

.tl-year {
  position: relative;
  z-index: 3;
  font-size: 24rpx;
  color: #C41E3A;
  font-weight: bold;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
  background: #f7f3ea;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(196, 30, 58, 0.24);
  box-shadow: 0 4rpx 12rpx rgba(56, 44, 34, 0.08);
  overflow: hidden;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 3rpx rgba(0,0,0,0.06), 0 0 0 8rpx rgba(196, 30, 58, 0.1), 0 0 12rpx rgba(196, 30, 58, 0.15);
  z-index: 2;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.tl-line {
  display: none;
}

.tl-card {
  flex: 1;
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.48);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 22rpx rgba(63, 47, 32, 0.09);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.tl-item:active .tl-card {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(63, 47, 32, 0.06);
}

.tl-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tl-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tl-title {
  font-size: 31rpx;
  font-weight: bold;
  color: #2C2C2C;
  flex: 1;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.tl-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.tl-tag text {
  font-size: 20rpx;
  color: #fff;
}

.tl-detail {
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(139, 157, 175, 0.16);
  margin-top: 8rpx;
}

.tl-detail text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.9;
}

.tl-expand-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8B9DAF;
  margin-top: 8rpx;
}
