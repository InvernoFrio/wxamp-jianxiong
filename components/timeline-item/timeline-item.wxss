.tl-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.tl-left {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-year {
  font-size: 25rpx;
  color: #C41E3A;
  font-weight: bold;
  margin-bottom: 8rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 3rpx rgba(0,0,0,0.08), 0 0 0 9rpx rgba(196, 30, 58, 0.12);
  z-index: 1;
}

.tl-line {
  width: 2rpx;
  flex: 1;
  background: linear-gradient(180deg, rgba(196, 30, 58, 0.38), rgba(139, 157, 175, 0.2));
  margin-top: 4rpx;
  min-height: 40rpx;
}

.tl-card {
  flex: 1;
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.48);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 22rpx rgba(63, 47, 32, 0.09);
}

.tl-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tl-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tl-title {
  font-size: 31rpx;
  font-weight: bold;
  color: #2C2C2C;
  flex: 1;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.tl-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.tl-tag text {
  font-size: 20rpx;
  color: #fff;
}

.tl-detail {
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(139, 157, 175, 0.16);
  margin-top: 8rpx;
}

.tl-detail text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.9;
}

.tl-expand-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8B9DAF;
  margin-top: 8rpx;
}
