<view class="reader-view {{theme === 'dark' ? 'dark' : ''}}">
  <view class="reader-content">
    <view
      wx:for="{{paragraphs}}"
      wx:key="index"
      class="paragraph"
      data-index="{{index}}"
      bindlongpress="onLongPress"
      style="font-size: {{fontSize}}rpx; line-height: {{lineHeight}};"
    >
      <text class="paragraph-text">{{item}}</text>
    </view>
    <view wx:if="{{paragraphs.length === 0}}" class="empty-tip">
      <text>暂无内容</text>
    </view>
  </view>

  <!-- 长按操作菜单 -->
  <view class="context-menu-overlay" wx:if="{{menuVisible}}" catchtap="onCloseMenu">
    <view class="context-menu" style="left: {{menuX}}px; top: {{menuY}}px;">
      <view class="menu-item" catchtap="onHighlight">
        <text>🖍 高亮</text>
      </view>
      <view class="menu-item" catchtap="onNote">
        <text>📝 笔记</text>
      </view>
      <view class="menu-item" catchtap="onCopy">
        <text>📋 复制</text>
      </view>
    </view>
  </view>
</view>
