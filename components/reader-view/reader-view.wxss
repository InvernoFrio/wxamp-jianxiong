/* components/reader-view/reader-view.wxss */
.reader-view {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.reader-header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(139, 157, 175, 0.15);
  flex-shrink: 0;
}

.section-label {
  font-size: 22rpx;
  color: var(--gray-blue);
  display: block;
  margin-bottom: 4rpx;
}

.section-name {
  font-family: var(--font-serif);
  font-size: 36rpx;
  color: var(--ink-black);
  font-weight: 600;
  display: block;
}

/* 正文 */
.reader-body {
  flex: 1;
  height: 0;
}

.paragraphs {
  padding: 32rpx;
}

.paragraph {
  margin-bottom: 36rpx;
}

.para-text {
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: var(--ink-black);
  line-height: 2.2;
  text-align: justify;
  text-indent: 2em;
}

/* 底部导航 */
.reader-footer {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid rgba(139, 157, 175, 0.15);
}

.nav-prev, .nav-next {
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(139, 157, 175, 0.2);
}

.nav-prev text, .nav-next text {
  font-size: 26rpx;
  color: var(--gray-blue);
}

.nav-next.primary {
  background: var(--vermillion);
  border-color: var(--vermillion);
}

.nav-next.primary text {
  color: #fff;
}

.nav-spacer {
  width: 1rpx;
}

/* 进度条 */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  background: rgba(245, 240, 232, 0.95);
  border-top: 1rpx solid rgba(139, 157, 175, 0.15);
  flex-shrink: 0;
}

.progress-track {
  flex: 1;
  height: 6rpx;
  background: rgba(139, 157, 175, 0.2);
  border-radius: 3rpx;
  margin-right: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--vermillion), var(--amber));
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--gray-blue);
  min-width: 50rpx;
  text-align: right;
}
