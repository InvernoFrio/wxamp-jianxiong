.reader-view {
  position: relative;
  display: block;
  width: 100%;
}

.reader-content {
  padding: 32rpx 34rpx;
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
  width: 100%;
  overflow-x: hidden;
}

.paragraph {
  display: block;
  width: 100%;
  margin-bottom: 28rpx;
  color: #2C2C2C;
  line-height: 2;
  font-size: 30rpx;
  word-break: break-word;
  overflow-wrap: break-word;
  white-space: normal;
  text-indent: 2em;
  text-align: justify;
  text-justify: inter-ideograph;
}

/* 首段无缩进，加装饰 */
.paragraph:first-child {
  text-indent: 2em;
}

.paragraph:first-child {
  font-size: 32rpx;
}

.context-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.context-menu {
  position: fixed;
  background: rgba(39, 34, 31, 0.92);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  padding: 8rpx 0;
  min-width: 180rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.34);
  z-index: 1000;
  transform: translate(-50%, -100%);
  margin-top: -20rpx;
}

.menu-item {
  padding: 16rpx 32rpx;
}

.menu-item text {
  color: #F5F0E8;
  font-size: 26rpx;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.15);
}

