.reader-view {
  position: relative;
}

.reader-content {
  padding: 24rpx 32rpx;
}

.paragraph {
  text-indent: 2em;
  margin-bottom: 20rpx;
  color: #2C2C2C;
}

.paragraph text {
  user-select: text;
  -webkit-user-select: text;
}

.context-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.context-menu {
  position: fixed;
  background: rgba(44, 44, 44, 0.9);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-radius: 16rpx;
  padding: 8rpx 0;
  min-width: 180rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  z-index: 1000;
  transform: translate(-50%, -100%);
  margin-top: -20rpx;
}

.menu-item {
  padding: 16rpx 32rpx;
}

.menu-item text {
  color: #F5F0E8;
  font-size: 26rpx;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.15);
}
