.reader-view {
  position: relative;
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.reader-content {
  padding: 36rpx 44rpx;
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.paragraph {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0 0 32rpx;
  padding: 0;
  color: #2C2C2C;
  line-height: 2;
  font-size: 30rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
  white-space: normal;
  text-indent: 2em;
}

.paragraph-text {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  white-space: normal;
  text-align: left;
  word-break: break-all;
  overflow-wrap: anywhere;
  text-indent: inherit;
}

.paragraph:first-child {
  text-indent: 2em;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #8B9DAF;
  font-size: 28rpx;
}

/* 深色主题 */
.dark .paragraph {
  color: #E0DDD7;
}

/* 上下文菜单 */
.context-menu-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
}

.context-menu {
  position: fixed;
  display: flex;
  background: rgba(39, 34, 31, 0.94);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  padding: 8rpx;
  min-width: 430rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.34);
  z-index: 1000;
  transform: translate(-50%, -100%);
  margin-top: -20rpx;
}

.menu-item {
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.menu-item text {
  color: #F5F0E8;
  font-size: 26rpx;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.15);
}
