.music-float {
  position: fixed;
  z-index: 1200;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.36) 48%, rgba(212, 165, 116, 0.22)),
    linear-gradient(145deg, rgba(196, 30, 58, 0.82), rgba(212, 165, 116, 0.72));
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 26rpx rgba(65, 49, 30, 0.18);
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
}

.music-float.compact {
  width: 68rpx;
  height: 68rpx;
}

.music-disc {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 250, 240, 0.9);
  box-shadow: inset 0 0 0 6rpx rgba(196, 30, 58, 0.08);
}

.music-note {
  color: #A62121;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 700;
}

.playing .music-disc {
  animation: noteSpin 3.2s linear infinite;
}

.paused .pause-slash {
  position: absolute;
  width: 62rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #2C2C2C;
  transform: rotate(-36deg);
  box-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.65);
}

.music-float:active {
  transform: scale(0.94);
}

@keyframes noteSpin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
