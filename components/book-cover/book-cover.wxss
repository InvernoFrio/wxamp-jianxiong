.book-scene {
  perspective: 1200rpx;
  width: 320rpx;
  height: 420rpx;
  margin: 0 auto;
}

.book {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.book-spine {
  position: absolute;
  left: 0;
  top: 0;
  width: 20rpx;
  height: 100%;
  background: #2C2C2C;
  transform: translateX(-10rpx);
  z-index: 2;
  border-radius: 4rpx 0 0 4rpx;
}

.book-page {
  position: absolute;
  top: 0;
  left: 10rpx;
  width: calc(100% - 10rpx);
  height: 100%;
  border-radius: 0 12rpx 12rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  backface-visibility: hidden;
  transform-origin: left center;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-page-back {
  background: #F5F0E8;
  z-index: 1;
  box-shadow: inset 8rpx 0 16rpx rgba(0, 0, 0, 0.08);
}

.book-page-front {
  background: linear-gradient(135deg, #F5F0E8 0%, #EDE5D8 100%);
  z-index: 3;
  border: 2rpx solid #D4A574;
  border-left: none;
}

.book-open .book-page-front {
  transform: rotateY(-160deg);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.page-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2C2C2C;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 18rpx;
  color: #8B9DAF;
  letter-spacing: 2rpx;
}

.page-line {
  width: 60rpx;
  height: 2rpx;
  background: #C41E3A;
  margin: 24rpx 0;
}

.page-author {
  font-size: 24rpx;
  color: #D4A574;
}

.page-hint {
  font-size: 22rpx;
  color: #8B9DAF;
  margin-top: 8rpx;
}
