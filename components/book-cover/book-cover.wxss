/* components/book-cover/book-cover.wxss */
.book-container {
  width: 400rpx;
  height: 560rpx;
  margin: 0 auto;
  position: relative;
  perspective: 1200rpx;
  cursor: pointer;
}

/* 封面 */
.book-cover {
  position: absolute;
  width: 100%;
  height: 100%;
  transform-origin: left center;
  transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 2;
}

.opening .book-cover {
  transform: rotateY(-165deg);
}

/* 封面正面 */
.book-front {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #8B1A1A 0%, #C41E3A 30%, #A01830 100%);
  border-radius: 4rpx 16rpx 16rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 
    inset 4rpx 0 12rpx rgba(0,0,0,0.3),
    8rpx 8rpx 24rpx rgba(0,0,0,0.25);
  backface-visibility: hidden;
  border: 2rpx solid #6B1010;
}

/* 书脊 */
.book-spine {
  position: absolute;
  left: -16rpx;
  top: 0;
  width: 16rpx;
  height: 100%;
  background: linear-gradient(90deg, #5A0E0E, #8B1A1A);
  transform: rotateY(-90deg) translateZ(0);
  border-radius: 4rpx 0 0 4rpx;
}

/* 书页侧面 */
.book-pages-side {
  position: absolute;
  right: -12rpx;
  top: 4rpx;
  width: 12rpx;
  height: calc(100% - 8rpx);
  background: repeating-linear-gradient(
    180deg,
    #F5F0E8 0rpx,
    #EDE5D8 1rpx,
    #F5F0E8 2rpx
  );
  border-radius: 0 4rpx 4rpx 0;
}

/* 封面文字 */
.book-title {
  text-align: center;
  padding: 0 32rpx;
}

.book-title-main {
  font-family: 'Noto Serif SC', serif;
  font-size: 48rpx;
  color: #F5E6D0;
  display: block;
  letter-spacing: 8rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.3);
}

.book-title-sub {
  font-size: 24rpx;
  color: rgba(245, 230, 208, 0.7);
  display: block;
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* 装饰线 */
.book-decoration {
  margin-top: 40rpx;
  text-align: center;
}

.book-line {
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(245, 230, 208, 0.5), transparent);
  margin: 8rpx auto;
}

.book-author {
  font-size: 22rpx;
  color: rgba(245, 230, 208, 0.6);
  letter-spacing: 6rpx;
}

/* 内页 */
.book-inner {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F5F0E8, #EDE5D8);
  border-radius: 4rpx 16rpx 16rpx 4rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 8rpx 8rpx 24rpx rgba(0,0,0,0.15);
  border: 1rpx solid #D4C5B0;
}

.inner-content {
  text-align: center;
  padding: 32rpx;
}

.inner-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #2C2C2C;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.inner-subtitle {
  font-size: 24rpx;
  color: var(--gray-blue);
  display: block;
}
