.book-scene {
  perspective: 1200rpx;
  width: 320rpx;
  height: 420rpx;
  margin: 0 auto;
  filter: drop-shadow(0 20rpx 24rpx rgba(53, 37, 28, 0.2));
}

.book {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.book-spine {
  position: absolute;
  left: 0;
  top: 0;
  width: 20rpx;
  height: 100%;
  background: linear-gradient(180deg, #3b2e27, #251c17 70%, #2e221c);
  transform: translateX(-10rpx);
  z-index: 2;
  border-radius: 4rpx 0 0 4rpx;
}

.book-page {
  position: absolute;
  top: 0;
  left: 10rpx;
  width: calc(100% - 10rpx);
  height: 100%;
  border-radius: 0 12rpx 12rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  backface-visibility: hidden;
  transform-origin: left center;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-page-back {
  background: linear-gradient(180deg, #f6f1e8 0%, #ede4d5 100%);
  z-index: 1;
  box-shadow: inset 8rpx 0 16rpx rgba(0, 0, 0, 0.08);
}

.book-page-front {
  background:
    radial-gradient(circle at 14% 16%, rgba(196, 30, 58, 0.1), transparent 34%),
    linear-gradient(135deg, #f9f5ec 0%, #e9decb 100%);
  z-index: 3;
  border: 2rpx solid rgba(212, 165, 116, 0.86);
  border-left: none;
}

.book-open .book-page-front {
  transform: rotateY(-160deg);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.24);
}

.page-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #2C2C2C;
  letter-spacing: 9rpx;
  margin-bottom: 12rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
}

.page-subtitle {
  font-size: 18rpx;
  color: #8B9DAF;
  letter-spacing: 3rpx;
}

.page-line {
  width: 76rpx;
  height: 3rpx;
  background: #C41E3A;
  margin: 24rpx 0;
}

.page-author {
  font-size: 24rpx;
  color: #D4A574;
}

.page-hint {
  font-size: 22rpx;
  color: #8B9DAF;
  margin-top: 8rpx;
}
