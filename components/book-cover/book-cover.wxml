<view class="book-scene" bindtap="onTap">
  <view class="book {{isOpen ? 'book-open' : ''}}">
    <view class="book-spine"></view>
    <view class="book-page book-page-back">
      <view class="page-content">
        <text class="page-title">吴健雄传</text>
        <text class="page-subtitle">THE BIOGRAPHY OF WU JIANXIONG</text>
        <view class="page-line"></view>
        <text class="page-author">张怀亮 编著</text>
      </view>
    </view>
    <view class="book-page book-page-front">
      <view class="page-content">
        <text class="page-title">健雄书韵</text>
        <text class="page-subtitle">WU JIANXIONG MEMORIAL</text>
        <view class="page-line"></view>
        <text class="page-hint">{{isOpen ? '点击关闭' : '点击翻开'}}</text>
      </view>
    </view>
  </view>
</view>
