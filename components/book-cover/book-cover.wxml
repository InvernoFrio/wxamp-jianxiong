<!--components/book-cover/book-cover.wxml-->
<view 
  class="book-container {{opening ? 'opening' : ''}}" 
  bindtap="onTap"
>
  <!-- 书本封面 -->
  <view class="book-cover">
    <view class="book-front">
      <view class="book-title">
        <text class="book-title-main">{{title}}</text>
        <text class="book-title-sub">{{subtitle}}</text>
      </view>
      <view class="book-decoration">
        <view class="book-line"></view>
        <text class="book-author">{{author}}</text>
        <view class="book-line"></view>
      </view>
    </view>
    <view class="book-spine"></view>
    <view class="book-pages-side"></view>
  </view>
  
  <!-- 翻开后的内页 -->
  <view class="book-inner">
    <view class="inner-content">
      <text class="inner-title">{{innerTitle}}</text>
      <text class="inner-subtitle">{{innerSubtitle}}</text>
    </view>
  </view>
</view>
