<!-- components/book-cover/book-cover.wxml -->
<view class="book-scene" bindtap="onTap">
  <view class="book {{isOpen ? 'book-open' : ''}} {{shrunk ? 'book-shrunk' : ''}} {{riffleClass}}">

    <!-- 书封内侧 -->
    <view class="book-page book-page-back">
      <view class="page-center">
        <text class="cover-title">吴 健 雄 传</text>
        <text class="cover-en">THE BIOGRAPHY OF WU JIANXIONG</text>
        <view class="cover-line"></view>
        <text class="cover-author">张怀亮 编著</text>
      </view>
    </view>

    <!-- 第二页：直接阅读 -->
    <view class="book-spread {{bookPage === 2 ? 'spread-on' : 'spread-off'}}">
      <view class="page-fill">
        <view class="spread-head">
          <text class="spread-emoji">📖</text>
          <text class="spread-title serif-title">直接阅读</text>
          <view class="spread-line"></view>
        </view>
      </view>
    </view>

    <!-- 第一页：探索地图 -->
    <view class="book-spread {{bookPage === 1 ? 'spread-on' : (bookPage === 0 ? 'spread-off' : 'spread-off-left')}}" catchtap="onGridWalkingTap">
      <view class="page-fill page-fill-map">
        <view class="spread-head">
          <image class="spread-logo" src="/assets/campus_logo.png" mode="aspectFit" />
          <text class="spread-title serif-title">探索地图</text>
          <view class="spread-line"></view>
          <view class="explore-guide">
            <view class="explore-guide-pulse"></view>
            <text class="explore-guide-main">点击书页进入探索</text>
            <text class="explore-guide-sub">沿真实地图寻找钴光足迹</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 翻页掠影：用于制造连续哗啦翻页感 -->
    <view class="riffle-stack">
      <view class="flutter-page flutter-page-1"></view>
      <view class="flutter-page flutter-page-2"></view>
      <view class="flutter-page flutter-page-3"></view>
      <view class="flutter-page flutter-page-4"></view>
      <view class="flutter-page flutter-page-5"></view>
      <view class="flutter-page flutter-page-6"></view>
      <view class="flutter-page flutter-page-7"></view>
    </view>

    <!-- 书封 -->
    <view class="book-page book-page-front">
      <view class="page-center">
        <text class="cover-title">钴 光 拾 遗</text>
        <text class="cover-en">COBALT LIGHT ARCHIVE</text>
        <view class="cover-line"></view>
        <text class="cover-hint">点击翻开</text>
      </view>
    </view>

  </view>
</view>
