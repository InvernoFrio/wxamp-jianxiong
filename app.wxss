/** app.wxss **/
page {
  /* 恢复纸韵色彩系统 */
  --paper-white: #F8F6F2;
  --paper-dark: #EFE7DA;
  --ink-black: #1A1A1A;
  --jianxiong-red: #A62121;
  --jianxiong-red-deep: #7F1717;
  --gold-accent: #D4A574;
  --warm-gold: #B88954;
  --slate-gray: #54606B;
  --mist-blue: #6F8494;
  --hairline: rgba(92, 70, 44, 0.12);

  background-color: var(--paper-white);
  color: var(--ink-black);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 通用毛玻璃卡片 (浅色版) */
.glass {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(24rpx) saturate(1.08);
  -webkit-backdrop-filter: blur(24rpx) saturate(1.08);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow:
    0 18rpx 48rpx rgba(78, 55, 32, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  border-radius: 24rpx;
}

.serif-title {
  font-family: "Noto Serif SC", serif;
  letter-spacing: 0.06em;
  font-weight: 600;
}

.active-scale:active {
  transform: scale(0.96);
  transition: transform 0.2s ease;
}
