/* app.wxss - 健雄书韵 全局样式 */

/* ============ CSS 变量 ============ */
page {
  /* 色彩系统 */
  --paper-white: #F5F0E8;
  --ink-black: #2C2C2C;
  --vermillion: #C41E3A;
  --gray-blue: #8B9DAF;
  --amber: #D4A574;
  --glass-bg: rgba(255, 255, 255, 0.22);
  --glass-border: rgba(255, 255, 255, 0.5);
  --glass-highlight: rgba(255, 255, 255, 0.6);
  --shadow: rgba(0, 0, 0, 0.08);

  /* 字体 */
  --font-serif: "Source Han Serif SC", "Noto Serif SC", "SimSun", serif;
  --font-sans: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 50%;
}

/* ============ 全局基础 ============ */
page {
  background-color: var(--paper-white);
  font-family: var(--font-sans);
  color: var(--ink-black);
  font-size: 28rpx;
  line-height: 1.8;
}

/* ============ 液态玻璃组件 ============ */

/* 磨砂卡片 */
.glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--glass-border);
  box-shadow: 
    inset 0 1rpx 0 var(--glass-highlight),
    0 4rpx 16rpx var(--shadow);
  padding: var(--spacing-md);
}

/* 磨砂按钮 */
.glass-btn {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 4rpx 16rpx var(--shadow);
  padding: var(--spacing-sm) var(--spacing-md);
  transition: transform 0.1s ease, filter 0.1s ease;
}

.glass-btn:active {
  transform: scale(0.97);
  filter: brightness(1.05);
}

/* ============ 通用工具类 ============ */

/* 宣纸纹理背景 */
.paper-bg {
  background-color: var(--paper-white);
  background-image: 
    radial-gradient(ellipse at 20% 30%, rgba(212, 165, 116, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(139, 157, 175, 0.06) 0%, transparent 50%);
}

/* 标题文字 */
.title-text {
  font-family: var(--font-serif);
  font-weight: 700;
  color: var(--ink-black);
}

/* 强调色 */
.vermillion {
  color: var(--vermillion);
}

/* 次要文字 */
.secondary-text {
  color: var(--gray-blue);
  font-size: 24rpx;
}

/* ============ 动画 ============ */

/* 页面进入 - 从下方淡入上滑 */
@keyframes fadeSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-slide-up {
  animation: fadeSlideUp 0.4s ease-out both;
}

/* 卡片出现 - 缩放+淡入 */
@keyframes scaleFadeIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.scale-fade-in {
  animation: scaleFadeIn 0.35s ease-out both;
}

/* 脉冲光晕 */
@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(196, 30, 58, 0.4);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(196, 30, 58, 0);
  }
}

.pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* ============ 翻书动画 ============ */
.book-container {
  perspective: 1200rpx;
  perspective-origin: left center;
}

.book-cover {
  transform-origin: left center;
  transition: transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);
}

.book-cover.opening {
  transform: rotateY(-160deg);
}

/* ============ 滚动条美化 ============ */
::-webkit-scrollbar {
  width: 4rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--gray-blue);
  border-radius: 2rpx;
}
